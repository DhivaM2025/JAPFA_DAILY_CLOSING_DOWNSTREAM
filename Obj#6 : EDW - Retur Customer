WITH PARAM AS (
    SELECT
        '20260101' AS START_DATE,
        '20260409' AS END_DATE
),
DO_RETUR AS (
--KUMPULKAN SEMUA RETUR
	SELECT DISTINCT 
		SO.SOURCE_SYSTEM ,
		SO.COMPANY_CODE,
		COM.COMPANY_NAME,
		SO.PLANT,
		PL.PLANT_NAME,
		CASE
		     WHEN SO.PLANT IN ('8501','8502','8503','8504','8505','8506','8507','8508','8509','8510','8511','8512','8513','8514','8515','8516','8517','8518','8519','8520','8521','8522','8523','8524','8525') THEN 'B2B PP'
		     WHEN SO.PLANT = '8700' THEN 'B2B VAM'
		     WHEN SO.PLANT IN ('90CA','90CB','90CC','90CD','90CE','90CF','90CG','90CH','90CI','90CJ','90CK','90CL','90CM','90CN') THEN 'B2C - BDG'
		     WHEN SO.PLANT = '90HA' THEN 'B2C - JKF'
		     WHEN SO.PLANT IN ('90BA','90BB') THEN 'B2C - JKMO'
		     WHEN SO.PLANT IN ('90AA','90AB','90AC','90AD','90AE','90AF','90AG','90AH','90AI','90AJ','90AK','90AL','90AM','90AN','90BC','90BD','90BE','90BF') THEN 'B2C - JKTO'
		     WHEN SO.PLANT IN ('90FA','90FB','90FC','90FD','90FE','90FF','90FG','90FH','90FI','90FJ','90FK','90JA','90LA','90NA','90OA','90QA') THEN 'B2C - LJB'
		     WHEN SO.PLANT IN ('90IA','90IB','90IC','90ID','90IE','90MA') THEN 'B2C - LJM'
		     WHEN SO.PLANT IN ('90GA','90GB','90GC','90GD','90GE','90GF','90GG','90GH','90GI','90GJ','90KA') THEN 'B2C - LJT'
		     WHEN SO.PLANT IN ('90EA','90EB','90EC','90ED','90EE','90EF','90EG','90EH','90EI','90EJ','90EK','90EL','90EM','90EN','90EO','90EP','90EQ','90PA') THEN 'B2C - SBY'
		     WHEN SO.PLANT = '906A' THEN 'B2C - SCM'
		     WHEN SO.PLANT IN ('90DA','90DB','90DC','90DD','90DE','90DF','90DG','90DH','90DI','90DJ','90DK','90DL','90DM','90DN','90DO') THEN 'B2C - SMG'
		     WHEN SO.PLANT = '8500' THEN 'JFI - B2B HO'
		     WHEN SO.PLANT = '8400' THEN 'JFI - EXPORT HO'
		     WHEN SO.PLANT = '9000' THEN 'JFI - HO'
		     WHEN SO.PLANT IN ('901A','902A','903A','904A','905A','905B','905C','905D','90VA','90VB','90VC','90WA','90XA','90YA','90ZA') THEN 'JFI - MFG'
		     ELSE NULL
	 	END AS PLANT_GROUP,
	 	SO.DISTRIBUTION_CHANNEL,
		AR.DISTRIBUTION_CHANNEL_DESC,
		SO.CUSTOMER,
		CU.CUSTOMER_NAME,
		CU.REGION,
		REG.REGION_DESCRIPTION,
		SO.SALES_ORDER_CREATED_DATE AS SO_RETUR_CREATED_DATE,
		SO.SALES_ORDER_NUMBER AS SO_RETUR,
		DO.DELIVERY_NUMBER AS DELIVERY_RETUR,
		DO.DELIVERY_CREATED_DATE AS DELIVERY_RETUR_CREATED_DATE,
		DO.DELIVERY_TYPE AS DELIVERY_RETUR_TYPE,
		DO.DELIVERY_TYPE_DESC AS DELIVERY_RETUR_TYPE_DESC,
		SO.RETURN_REFERENCE_DOCUMENT_NUMBER AS BILLING_ORI,
		BO.BILLING_NUMBER AS BILLING_RETUR,
		SO.MATERIAL AS MATERIAL_RETUR,
		MAT.MATERIAL_DESC AS MATERIAL_DESCRIPTION ,
		SUM(SO.SALES_ORDER_QUANTITY_IN_BASE_UOM) AS RETUR_SO_QTY,
		SO.SALES_ORDER_NET_AMOUNT AS RETUR_SO_AMOUNT,
		ROUND(COALESCE(SO.SALES_ORDER_NET_AMOUNT / NULLIF(SO.SALES_ORDER_QUANTITY_IN_BASE_UOM,0),0),2) AS RETUR_PRICE,
		SO.SALES_ORDER_STATUS,
		SO.SALES_ORDER_STATUS_DESC,
		SO.SALES_ORDER_STATUS_DELIVERY,
		SO.SALES_ORDER_STATUS_DELIVERY_DESC ,
		DO.SALES_ORDER_REASON ,
		DO.SALES_ORDER_REASON_DESC,
		DO.DELIVERY_NOTE
	FROM F_SALES_SALES_ORDER SO
	CROSS JOIN PARAM
	LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM, REFERENCE_SALES_ORDER_NUMBER, BILLING_NUMBER FROM F_SALES_BILLING) BO 
		ON SO.SOURCE_SYSTEM = BO.SOURCE_SYSTEM AND SO.SALES_ORDER_NUMBER = BO.REFERENCE_SALES_ORDER_NUMBER
	LEFT JOIN F_SALES_DELIVERY DO 
		ON SO.SOURCE_SYSTEM = DO.SOURCE_SYSTEM AND SO.SALES_ORDER_NUMBER = DO.REFERENCE_SALES_ORDER_NUMBER AND SO.SALES_ORDER_ITEM = DO.REFERENCE_SALES_ORDER_ITEM
	-- COLLAPSED JOIN: 1 row per BILLING_ORI, safe from fanout
	LEFT JOIN (
		SELECT
			BI.SOURCE_SYSTEM,
			BI.BILLING_NUMBER,
			MIN(DEL.DELIVERY_CREATED_DATE) AS DELIVERY_CREATED_DATE
		FROM F_SALES_BILLING BI
		LEFT JOIN F_SALES_DELIVERY DEL
			ON BI.SOURCE_SYSTEM = DEL.SOURCE_SYSTEM AND BI.REFERENCE_DOCUMENT_NUMBER = DEL.DELIVERY_NUMBER
		GROUP BY ALL
	) ORI_DO ON SO.SOURCE_SYSTEM = ORI_DO.SOURCE_SYSTEM AND SO.RETURN_REFERENCE_DOCUMENT_NUMBER = ORI_DO.BILLING_NUMBER
	LEFT JOIN D_SCM_COMPANY COM ON SO.SOURCE_SYSTEM = COM.SOURCE_SYSTEM AND SO.COMPANY_CODE = COM.COMPANY_CODE
	LEFT JOIN D_SCM_PLANT PL ON SO.SOURCE_SYSTEM = PL.SOURCE_SYSTEM AND SO.PLANT = PL.PLANT AND SO.COMPANY_CODE = PL.COMPANY_CODE
	LEFT JOIN D_SALES_AREA AR ON SO.SOURCE_SYSTEM = AR.SOURCE_SYSTEM AND SO.COMPANY_CODE = AR.COMPANY_CODE AND SO.SALES_OFFICE = AR.SALES_OFFICE AND SO.DISTRIBUTION_CHANNEL = AR.DISTRIBUTION_CHANNEL AND SO.SALES_ORGANIZATION = AR.SALES_ORGANIZATION AND SO.DIVISION = AR.SALES_DIVISION
	LEFT JOIN D_SALES_CUSTOMER CU ON SO.SOURCE_SYSTEM = CU.SOURCE_SYSTEM AND SO.CUSTOMER = CU.CUSTOMER AND SO.DISTRIBUTION_CHANNEL = CU.DISTRIBUTION_CHANNEL AND SO.SALES_ORGANIZATION = CU.SALES_ORGANIZATION AND SO.DIVISION = CU.SALES_DIVISION 
	LEFT JOIN D_SALES_REGION REG ON CU.SOURCE_SYSTEM = REG.SOURCE_SYSTEM AND CU.COUNTRY = REG.COUNTRY AND CU.REGION = REG.REGION
	LEFT JOIN D_SCM_MATERIAL MAT ON SO.SOURCE_SYSTEM = MAT.SOURCE_SYSTEM AND SO.MATERIAL = MAT.MATERIAL 
	WHERE 
	(
		-- SO.SALES_ORDER_CREATED_DATE BETWEEN PARAM.START_DATE AND PARAM.END_DATE
		ORI_DO.DELIVERY_CREATED_DATE BETWEEN PARAM.START_DATE AND PARAM.END_DATE
		AND SO.SALES_ORDER_TYPE IN ('ZB51', 'ZB54', 'ZKR1', 'ZKR2', 'ZKRA') AND SO.SOURCE_SYSTEM = 'PE1'
	) OR
	(
		-- SO.SALES_ORDER_CREATED_DATE BETWEEN PARAM.START_DATE AND PARAM.END_DATE
		ORI_DO.DELIVERY_CREATED_DATE BETWEEN PARAM.START_DATE AND PARAM.END_DATE
		AND SO.SALES_ORDER_TYPE IN ('ZKR1', 'ZKR2', 'ZKR3','ZKR5', 'ZKR6', 'ZKRA') AND SO.SOURCE_SYSTEM = 'PE2'
	)
	GROUP BY ALL 
)
, DO_ORI AS (
	SELECT --retur
		DISTINCT
		'RETUR' AS TYPE_TR,
		DR.SOURCE_SYSTEM,
		DR.COMPANY_CODE,
		DR.COMPANY_NAME,
		DR.PLANT,
		DR.PLANT_NAME,
		DR.PLANT_GROUP,
		DR.DISTRIBUTION_CHANNEL,
		DR.DISTRIBUTION_CHANNEL_DESC,
		DR.CUSTOMER,
		DR.CUSTOMER_NAME,
		DR.REGION,
		DR.REGION_DESCRIPTION,
		DR.SO_RETUR_CREATED_DATE,
		SO.SALES_ORDER_CREATED_DATE AS SO_ORI_CREATED_DATE,
		DR.SO_RETUR,
		DR.DELIVERY_RETUR,
		DR.DELIVERY_RETUR_CREATED_DATE,
		DR.DELIVERY_RETUR_TYPE,
		DR.DELIVERY_RETUR_TYPE_DESC,
		DR.BILLING_ORI,
		DR.BILLING_RETUR,
		DR.MATERIAL_RETUR,
		DR.MATERIAL_DESCRIPTION,
		DR.RETUR_SO_QTY,
		DR.RETUR_SO_AMOUNT,
		DR.RETUR_PRICE,
		DR.SALES_ORDER_STATUS,
		DR.SALES_ORDER_STATUS_DESC,
		DR.SALES_ORDER_STATUS_DELIVERY,
		DR.SALES_ORDER_STATUS_DELIVERY_DESC,
		DR.SALES_ORDER_REASON,
		DR.SALES_ORDER_REASON_DESC,
		DR.DELIVERY_NOTE ,
		BO.REFERENCE_SALES_ORDER_NUMBER AS SO_ORI,
		SO.MATERIAL_ORI,
		SO.ORI_PRICE,
		SO.SO_ORI_AMOUNT,
		SO.SO_ORI_QTY,
		BO.REFERENCE_DOCUMENT_NUMBER AS DELIVERY_ORI,
		DO.DELIVERY_CREATED_DATE AS DELIVERY_ORI_CREATED_DATE,
		DO.DELIVERY_POSTING_DATE AS POD_DATE,
		DO.DELIVERY_TYPE AS DELIVERY_ORI_TYPE,
		DO.DELIVERY_TYPE_DESC AS DELIVERY_ORI_TYPE_DESC
	FROM DO_RETUR DR 
	LEFT JOIN F_SALES_BILLING BO ON DR.SOURCE_SYSTEM = BO.SOURCE_SYSTEM AND DR.BILLING_ORI = BO.BILLING_NUMBER
	LEFT JOIN (SELECT 
					DISTINCT
					SOURCE_SYSTEM,
					DELIVERY_NUMBER,
					DELIVERY_TYPE, 
					DELIVERY_TYPE_DESC ,
					f.DELIVERY_CREATED_DATE,
					DELIVERY_POSTING_DATE 
				FROM F_SALES_DELIVERY f 
	) DO ON BO.SOURCE_SYSTEM = DO.SOURCE_SYSTEM AND BO.REFERENCE_DOCUMENT_NUMBER = DO.DELIVERY_NUMBER
	LEFT JOIN (SELECT
					DISTINCT 
					f.SOURCE_SYSTEM,
					f.SALES_ORDER_NUMBER,
					F.SALES_ORDER_CREATED_DATE,
					f.MATERIAL AS MATERIAL_ORI,
					SUM(F.SALES_ORDER_QUANTITY_IN_BASE_UOM) AS SO_ORI_QTY,
					SUM(F.SALES_ORDER_NET_AMOUNT) AS SO_ORI_AMOUNT,
					ROUND(COALESCE(F.SALES_ORDER_NET_AMOUNT / NULLIF(F.SALES_ORDER_QUANTITY_IN_BASE_UOM,0),0),2) AS ORI_PRICE
					FROM F_SALES_SALES_ORDER f 
					GROUP BY ALL 
	) SO ON BO.REFERENCE_SALES_ORDER_NUMBER = SO.SALES_ORDER_NUMBER AND BO.SOURCE_SYSTEM = SO.SOURCE_SYSTEM AND DR.MATERIAL_RETUR = SO.MATERIAL_ORI
	WHERE NOT (DR.DELIVERY_RETUR_TYPE IN ('ZB01', 'ZB02', 'ZB05', 'ZB04', 'ZKD1', 'ZKD4', 'ZKD9', 'ZKDA', 'ZKDE') AND DR.SOURCE_SYSTEM = 'PE1' AND DR.DELIVERY_NOTE IS NOT NULL AND TRIM(DR.DELIVERY_NOTE) <> '')
	UNION ALL
	SELECT --qty tolakan, PE1 only
		DISTINCT 
		'TOLAKAN' AS TYPE_TR,
		DO.SOURCE_SYSTEM,
		DO.COMPANY_CODE,
		COM.COMPANY_NAME,
		DO.PLANT,
		PL.PLANT_NAME,
		CASE
		     WHEN DO.PLANT IN ('8501','8502','8503','8504','8505','8506','8507','8508','8509','8510','8511','8512','8513','8514','8515','8516','8517','8518','8519','8520','8521','8522','8523','8524','8525') THEN 'B2B PP'
		     WHEN DO.PLANT = '8700' THEN 'B2B VAM'
		     WHEN DO.PLANT IN ('90CA','90CB','90CC','90CD','90CE','90CF','90CG','90CH','90CI','90CJ','90CK','90CL','90CM','90CN') THEN 'B2C - BDG'
		     WHEN DO.PLANT = '90HA' THEN 'B2C - JKF'
		     WHEN DO.PLANT IN ('90BA','90BB') THEN 'B2C - JKMO'
		     WHEN DO.PLANT IN ('90AA','90AB','90AC','90AD','90AE','90AF','90AG','90AH','90AI','90AJ','90AK','90AL','90AM','90AN','90BC','90BD','90BE','90BF') THEN 'B2C - JKTO'
		     WHEN DO.PLANT IN ('90FA','90FB','90FC','90FD','90FE','90FF','90FG','90FH','90FI','90FJ','90FK','90JA','90LA','90NA','90OA','90QA') THEN 'B2C - LJB'
		     WHEN DO.PLANT IN ('90IA','90IB','90IC','90ID','90IE','90MA') THEN 'B2C - LJM'
		     WHEN DO.PLANT IN ('90GA','90GB','90GC','90GD','90GE','90GF','90GG','90GH','90GI','90GJ','90KA') THEN 'B2C - LJT'
		     WHEN DO.PLANT IN ('90EA','90EB','90EC','90ED','90EE','90EF','90EG','90EH','90EI','90EJ','90EK','90EL','90EM','90EN','90EO','90EP','90EQ','90PA') THEN 'B2C - SBY'
		     WHEN DO.PLANT = '906A' THEN 'B2C - SCM'
		     WHEN DO.PLANT IN ('90DA','90DB','90DC','90DD','90DE','90DF','90DG','90DH','90DI','90DJ','90DK','90DL','90DM','90DN','90DO') THEN 'B2C - SMG'
		     WHEN DO.PLANT = '8500' THEN 'JFI - B2B HO'
		     WHEN DO.PLANT = '8400' THEN 'JFI - EXPORT HO'
		     WHEN DO.PLANT = '9000' THEN 'JFI - HO'
		     WHEN DO.PLANT IN ('901A','902A','903A','904A','905A','905B','905C','905D','90VA','90VB','90VC','90WA','90XA','90YA','90ZA') THEN 'JFI - MFG'
		     ELSE NULL
	 	END AS PLANT_GROUP,
		DO.DISTRIBUTION_CHANNEL,
		AR.DISTRIBUTION_CHANNEL_DESC,
		DO.CUSTOMER,
		CU.CUSTOMER_NAME,
		CU.REGION,
		REG.REGION_DESCRIPTION,
		NULL AS SO_RETUR_CREATED_DATE,
		SO.SALES_ORDER_CREATED_DATE AS SO_ORI_CREATED_DATE,
		NULL AS SO_RETUR,
		NULL AS DELIVERY_RETUR,
		NULL AS DELIVERY_RETUR_CREATED_DATE,
		NULL AS DELIVERY_RETUR_TYPE,
		NULL AS DELIVERY_RETUR_TYPE_DESC,
		BO.BILLING_NUMBER AS BILLING_ORI,
		NULL AS BILLING_RETUR,
		NULL AS MATERIAL_RETUR,
		MAT.MATERIAL_DESC AS MATERIAL_DESCRIPTION,
		NULL AS RETUR_SO_QTY,
		NULL AS RETUR_SO_AMOUNT,
		NULL AS RETUR_PRICE,
		SO.SALES_ORDER_STATUS,
		SO.SALES_ORDER_STATUS_DESC,
		SO.SALES_ORDER_STATUS_DELIVERY,
		SO.SALES_ORDER_STATUS_DELIVERY_DESC,
		DO.SALES_ORDER_REASON,
		DO.SALES_ORDER_REASON_DESC,
		DO.DELIVERY_NOTE,
		DO.REFERENCE_SALES_ORDER_NUMBER AS SO_ORI,
		SO.MATERIAL_ORI,
		SO.ORI_PRICE,
		SO.SO_ORI_AMOUNT,
		SO.SO_ORI_QTY,
		DO.DELIVERY_NUMBER AS DELIVERY_ORI,
		DO.DELIVERY_CREATED_DATE AS DELIVERY_ORI_CREATED_DATE,
		DO.DELIVERY_POSTING_DATE AS POD_DATE,
		DO.DELIVERY_TYPE AS DELIVERY_ORI_TYPE,
		DO.DELIVERY_TYPE_DESC AS DELIVERY_ORI_TYPE_DESC
	FROM (
		SELECT 
			DISTINCT 
			DO.SOURCE_SYSTEM,
			DO.COMPANY_CODE ,
			DO.DELIVERY_NUMBER ,
			DO.PLANT,
			DO.MATERIAL ,
			DO.CUSTOMER ,
			DO.DISTRIBUTION_CHANNEL ,
			DO.SALES_OFFICE ,
			DO.SALES_DIVISION ,
			DO.SALES_ORGANIZATION ,
			DO.DELIVERY_TYPE,
			DO.DELIVERY_TYPE_DESC,
			DO.DELIVERY_CREATED_DATE,
			DO.DELIVERY_POSTING_DATE,
			DO.SALES_ORDER_REASON ,
			DO.SALES_ORDER_REASON_DESC,
			DO.DELIVERY_NOTE,
			DO.REFERENCE_SALES_ORDER_NUMBER
		FROM F_SALES_DELIVERY DO 
		WHERE DO.DELIVERY_TYPE IN ('ZB01', 'ZB02', 'ZB05', 'ZB04', 'ZKD1', 'ZKD4', 'ZKD9', 'ZKDA', 'ZKDE') AND DO.SOURCE_SYSTEM = 'PE1' AND DO.DELIVERY_NOTE IS NOT NULL AND TRIM(DELIVERY_NOTE) <> ''
		) DO 
	CROSS JOIN PARAM
	LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM, REFERENCE_DOCUMENT_NUMBER, BILLING_NUMBER, BILLING_TYPE FROM F_SALES_BILLING) BO 
		ON BO.SOURCE_SYSTEM = DO.SOURCE_SYSTEM AND BO.REFERENCE_DOCUMENT_NUMBER = DO.DELIVERY_NUMBER
	LEFT JOIN (SELECT
					DISTINCT 
					f.SOURCE_SYSTEM,
					f.SALES_ORDER_NUMBER,
					f.MATERIAL AS MATERIAL_ORI,
					F.SALES_ORDER_CREATED_DATE,
					F.SALES_ORDER_STATUS,
					F.SALES_ORDER_STATUS_DESC,
					F.SALES_ORDER_STATUS_DELIVERY,
					F.SALES_ORDER_STATUS_DELIVERY_DESC ,
					SUM(F.SALES_ORDER_NET_AMOUNT) AS SO_ORI_AMOUNT,
					SUM(F.SALES_ORDER_QUANTITY_IN_BASE_UOM) AS SO_ORI_QTY,
					ROUND(COALESCE(F.SALES_ORDER_NET_AMOUNT / NULLIF(F.SALES_ORDER_QUANTITY_IN_BASE_UOM,0),0),2) AS ORI_PRICE
					FROM F_SALES_SALES_ORDER f 
					GROUP BY ALL 
		) SO ON DO.REFERENCE_SALES_ORDER_NUMBER = SO.SALES_ORDER_NUMBER AND DO.SOURCE_SYSTEM = SO.SOURCE_SYSTEM AND DO.MATERIAL = SO.MATERIAL_ORI
	LEFT JOIN D_SCM_COMPANY COM ON DO.SOURCE_SYSTEM = COM.SOURCE_SYSTEM AND DO.COMPANY_CODE = COM.COMPANY_CODE
	LEFT JOIN D_SCM_PLANT PL ON DO.SOURCE_SYSTEM = PL.SOURCE_SYSTEM AND DO.PLANT = PL.PLANT AND DO.COMPANY_CODE = PL.COMPANY_CODE
	LEFT JOIN D_SALES_AREA AR ON DO.SOURCE_SYSTEM = AR.SOURCE_SYSTEM AND DO.COMPANY_CODE = AR.COMPANY_CODE AND DO.SALES_OFFICE = AR.SALES_OFFICE AND DO.DISTRIBUTION_CHANNEL = AR.DISTRIBUTION_CHANNEL AND DO.SALES_ORGANIZATION = AR.SALES_ORGANIZATION AND DO.SALES_DIVISION = AR.SALES_DIVISION
	LEFT JOIN D_SALES_CUSTOMER CU ON DO.SOURCE_SYSTEM = CU.SOURCE_SYSTEM AND DO.CUSTOMER = CU.CUSTOMER AND DO.DISTRIBUTION_CHANNEL = CU.DISTRIBUTION_CHANNEL AND DO.SALES_ORGANIZATION = CU.SALES_ORGANIZATION AND DO.SALES_DIVISION = CU.SALES_DIVISION 
	LEFT JOIN D_SALES_REGION REG ON CU.SOURCE_SYSTEM = REG.SOURCE_SYSTEM AND CU.COUNTRY = REG.COUNTRY AND CU.REGION = REG.REGION
	LEFT JOIN D_SCM_MATERIAL MAT ON DO.SOURCE_SYSTEM = MAT.SOURCE_SYSTEM AND DO.MATERIAL = MAT.MATERIAL 
	WHERE
	SO.SALES_ORDER_CREATED_DATE BETWEEN PARAM.START_DATE AND PARAM.END_DATE
	-- DO.DELIVERY_CREATED_DATE BETWEEN PARAM.START_DATE AND PARAM.END_DATE
	AND NOT (
		BO.BILLING_TYPE = 'ZB50'
		AND BO.SOURCE_SYSTEM = 'PE1'
	)	
)
,/* MOVEMENT MAPPING */ 
MVT_MAP AS (
	SELECT
		COLUMN1 AS SOURCE_SYSTEM,
		COLUMN2 AS MOVEMENT_TYPE,
		COLUMN3 AS METRIC
	FROM VALUES
	/* DELIVERED */
	('PE1','601','DELIVERED_QTY'),
	('PE1','602','DELIVERED_QTY'),
	('PE2','633','DELIVERED_QTY'),
	('PE2','634','DELIVERED_QTY'),
	/* POD */
	('PE1','Z07','POD_QTY'),
	('PE1','Z08','POD_QTY'),
	/* TOLAKAN */
	('PE1','Z19','QTY_TOLAKAN'),
	('PE1','Z20','QTY_TOLAKAN'),
	/* RETURN POST SALES PE1 */
	('PE1','657','QTY_RETUR_POST_SALES'),
	('PE1','658','QTY_RETUR_POST_SALES'),
	('PE1','655','QTY_RETUR_POST_SALES'),
	('PE1','656','QTY_RETUR_POST_SALES'),
	('PE1','653','QTY_RETUR_POST_SALES'),
	('PE1','654','QTY_RETUR_POST_SALES'),
	/* RETURN POST SALES PE2 */
	('PE2','655','QTY_RETUR_POST_SALES'),
	('PE2','656','QTY_RETUR_POST_SALES'),
	('PE2','657','QTY_RETUR_POST_SALES'),
	('PE2','658','QTY_RETUR_POST_SALES'),
	('PE2','653','QTY_RETUR_POST_SALES'),
	('PE2','654','QTY_RETUR_POST_SALES'),
	('PE2','632','QTY_RETUR_POST_SALES'),
	('PE2','633','QTY_RETUR_POST_SALES')
),
/* AGGREGATE STOCK */
STOCK_AGG AS (
	SELECT
		S.SOURCE_SYSTEM,
		S.REFERENCE,
		S.BASE_UOM,
		S.MATERIAL,
        MIN(CASE WHEN M.METRIC = 'POD_QTY'
			THEN S.POSTING_DATE END) AS GR_TOLAKAN_POSTING_DATE,
		SUM(CASE WHEN M.METRIC='DELIVERED_QTY'
			THEN S.SIGNED_QUANTITY_FOR_BALANCE END) AS DELIVERED_QTY,
		SUM(CASE WHEN M.METRIC='POD_QTY'
			THEN S.SIGNED_QUANTITY_FOR_BALANCE END) AS POD_QTY,
		SUM(CASE WHEN M.METRIC='QTY_TOLAKAN'
			THEN S.SIGNED_QUANTITY_FOR_BALANCE END) AS QTY_TOLAKAN,
		SUM(CASE WHEN M.METRIC='QTY_RETUR_POST_SALES'
			THEN S.SIGNED_QUANTITY_FOR_BALANCE END) AS QTY_RETUR_POST_SALES
	FROM F_SCM_STOCK_TRANSACTION_SAP S
	LEFT JOIN MVT_MAP M
		ON S.SOURCE_SYSTEM = M.SOURCE_SYSTEM
		AND S.MOVEMENT_TYPE = M.MOVEMENT_TYPE
	WHERE ITEM_AUTOMATICALLY_CREATED IS NULL
	GROUP BY ALL
),
POD_AGG AS (
    SELECT
        pod.SOURCE_SYSTEM,
        pod.DELIVERY_NUMBER,
        pod.MATERIAL,
        SUM(pod.DIFF_POD_QUANTITY_IN_BASE_UOM) AS DIFF_POD_QTY,
		MIN(pod.POD_DATE) AS DIFF_POD_DATE
    FROM F_SALES_DELIVERY_POD pod
    GROUP BY
        pod.SOURCE_SYSTEM,
        pod.DELIVERY_NUMBER,
        pod.MATERIAL
)
SELECT
	DR.TYPE_TR,
	DR.SOURCE_SYSTEM,
	DR.COMPANY_CODE ||'-'|| DR.COMPANY_NAME AS COMPANY,
	DR.PLANT ||'-'|| DR.PLANT_NAME AS PLANT,
	DR.PLANT_GROUP,
	DR.DISTRIBUTION_CHANNEL ||'-'|| DR.DISTRIBUTION_CHANNEL_DESC AS DISTRIBUTION_CHANNEL,
	DR.CUSTOMER,
	DR.CUSTOMER_NAME,
	DR.REGION ||'-'|| DR.REGION_DESCRIPTION AS CUSTOMER_REGION,
	DR.SO_ORI AS SALES_ORDER_NUMBER,
	DR.DELIVERY_ORI AS DELIVERY_NUMBER,
	DR.BILLING_ORI AS BILLING_NUMBER,
	DR.SO_RETUR AS SALES_ORDER_RETUR_NUMBER,
	DR.DELIVERY_RETUR AS DELIVERY_RETUR_NUMBER,
	DR.BILLING_RETUR AS BILLING_RETUR_NUMBER,
	DR.MATERIAL_ORI,
	O.BASE_UOM AS BASE_UOM_ORI,
	DR.MATERIAL_RETUR,
	DR.MATERIAL_DESCRIPTION,
	R.BASE_UOM AS BASE_UOM_RETUR,
	DR.SO_ORI_QTY AS SO_QTY,
	DR.ORI_PRICE AS SO_PRICE,
	DR.SO_ORI_AMOUNT AS SO_AMOUNT,
	O.DELIVERED_QTY AS DO_QTY,
	POD.DIFF_POD_QTY,
	O.POD_QTY AS GR_TOLAKAN_QTY,
	R.QTY_RETUR_POST_SALES AS DO_RETUR_QTY,
	(DR.RETUR_PRICE * R.QTY_RETUR_POST_SALES) AS DO_RETUR_AMOUNT,
	DR.RETUR_SO_QTY AS SO_RETUR_QTY,
	DR.RETUR_PRICE AS SO_RETUR_PRICE,
	DR.RETUR_SO_AMOUNT AS SO_RETUR_AMOUNT,
	DR.DELIVERY_ORI_TYPE ||'-'|| DR.DELIVERY_ORI_TYPE_DESC AS DO_TYPE,
	DR.DELIVERY_RETUR_TYPE ||'-'|| DR.DELIVERY_RETUR_TYPE_DESC AS DO_RETUR_TYPE,
	DR.SALES_ORDER_STATUS ||'-'|| DR.SALES_ORDER_STATUS_DESC AS SO_RETUR_STATUS,
	DR.SALES_ORDER_STATUS_DELIVERY ||'-'|| DR.SALES_ORDER_STATUS_DELIVERY_DESC AS DO_RETUR_STATUS,
	DR.SALES_ORDER_REASON ||'-'|| DR.SALES_ORDER_REASON_DESC AS RETUR_REASON,
	DR.DELIVERY_NOTE AS TOLAKAN_REASON_POD,
	CASE 
    	WHEN DR.SO_ORI_CREATED_DATE IS NULL OR DR.SO_ORI_CREATED_DATE = '00000000' 
    	THEN NULL
    	ELSE TO_DATE(DR.SO_ORI_CREATED_DATE, 'YYYYMMDD')
	END AS SALES_ORDER_CREATED_DATE,
	CASE 
    	WHEN DR.DELIVERY_ORI_CREATED_DATE IS NULL OR DR.DELIVERY_ORI_CREATED_DATE = '00000000' 
    	THEN NULL
    	ELSE TO_DATE(DR.DELIVERY_ORI_CREATED_DATE, 'YYYYMMDD')
	END AS DELIVERY_ORDER_CREATED_DATE,
	CASE 
    	WHEN POD.DIFF_POD_DATE IS NULL OR POD.DIFF_POD_DATE = '00000000' THEN NULL
    	ELSE TO_DATE(POD.DIFF_POD_DATE, 'YYYYMMDD')
	END AS DIFF_POD_DATE,
	CASE 
    	WHEN O.GR_TOLAKAN_POSTING_DATE IS NULL OR O.GR_TOLAKAN_POSTING_DATE = '00000000' THEN NULL
    	ELSE TO_DATE(O.GR_TOLAKAN_POSTING_DATE, 'YYYYMMDD')
	END AS GR_TOLAKAN_POSTING_DATE,
	CASE 
    	WHEN DR.SO_RETUR_CREATED_DATE IS NULL OR DR.SO_RETUR_CREATED_DATE = '00000000' THEN NULL
    	ELSE TO_DATE(DR.SO_RETUR_CREATED_DATE, 'YYYYMMDD')
	END AS SO_RETUR_CREATED_DATE,
	CASE 
    	WHEN DR.DELIVERY_RETUR_CREATED_DATE IS NULL OR DR.DELIVERY_RETUR_CREATED_DATE = '00000000' THEN NULL
    	ELSE TO_DATE(DR.DELIVERY_RETUR_CREATED_DATE, 'YYYYMMDD')
	END AS DELIVERY_RETUR_CREATED_DATE,
	CASE
	    WHEN POD.DIFF_POD_DATE IS NOT NULL AND POD.DIFF_POD_DATE <> '00000000' AND O.GR_TOLAKAN_POSTING_DATE IS NOT NULL AND O.GR_TOLAKAN_POSTING_DATE <> '00000000'
	    THEN TO_VARCHAR(DATEDIFF(DAY,TO_DATE(POD.DIFF_POD_DATE, 'YYYYMMDD'),TO_DATE(O.GR_TOLAKAN_POSTING_DATE, 'YYYYMMDD')))
	    WHEN (O.GR_TOLAKAN_POSTING_DATE IS NULL OR O.GR_TOLAKAN_POSTING_DATE = '00000000') AND POD.DIFF_POD_DATE IS NOT NULL AND POD.DIFF_POD_DATE <> '00000000'
	    THEN TO_VARCHAR(DATEDIFF(DAY,TO_DATE(POD.DIFF_POD_DATE, 'YYYYMMDD'),CURRENT_DATE))
	    ELSE 'N/A'
	END AS SELISIH_DIFF_POD_GR_TOLAKAN,
	CASE
	    WHEN SELISIH_DIFF_POD_GR_TOLAKAN = 'N/A' THEN 'N/A'
	    WHEN SELISIH_DIFF_POD_GR_TOLAKAN = 0 THEN '1/ Hari - H'
	    WHEN ABS(SELISIH_DIFF_POD_GR_TOLAKAN) = 1 THEN '2/ 1 Hari'
	    WHEN ABS(SELISIH_DIFF_POD_GR_TOLAKAN) = 2 THEN '3/ 2 Hari'
	    WHEN ABS(SELISIH_DIFF_POD_GR_TOLAKAN) = 3 THEN '4/ 3 Hari'
	    WHEN ABS(SELISIH_DIFF_POD_GR_TOLAKAN) BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
	    WHEN ABS(SELISIH_DIFF_POD_GR_TOLAKAN) BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
	    WHEN ABS(SELISIH_DIFF_POD_GR_TOLAKAN) BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
	    WHEN ABS(SELISIH_DIFF_POD_GR_TOLAKAN) > 30 THEN '8/ >30 Hari'
	    ELSE ''
	END AS AGING_DIFF_POD_GR_TOLAKAN,	
	CASE
		WHEN DR.SO_RETUR_CREATED_DATE IS NOT NULL AND DR.SO_RETUR_CREATED_DATE <> '00000000' AND DR.DELIVERY_RETUR_CREATED_DATE IS NOT NULL AND DR.DELIVERY_RETUR_CREATED_DATE <> '00000000'
	    THEN TO_VARCHAR(DATEDIFF(DAY,TO_DATE(DR.SO_RETUR_CREATED_DATE, 'YYYYMMDD'),TO_DATE(DR.DELIVERY_RETUR_CREATED_DATE, 'YYYYMMDD')))
	    WHEN DR.SO_RETUR_CREATED_DATE IS NOT NULL AND DR.SO_RETUR_CREATED_DATE <> '00000000' AND (DR.DELIVERY_RETUR_CREATED_DATE IS NULL OR DR.DELIVERY_RETUR_CREATED_DATE = '00000000')
	    THEN TO_VARCHAR(DATEDIFF(DAY,TO_DATE(DR.SO_RETUR_CREATED_DATE, 'YYYYMMDD'),CURRENT_DATE))
	    ELSE 'N/A'
	END AS SELISIH_SO_RETUR_DO_RETUR,
	CASE
	    WHEN SELISIH_SO_RETUR_DO_RETUR = 'N/A' THEN 'N/A'
	    WHEN SELISIH_SO_RETUR_DO_RETUR = 0 THEN '1/ Hari - H'
	    WHEN ABS(SELISIH_SO_RETUR_DO_RETUR) = 1 THEN '2/ 1 Hari'
	    WHEN ABS(SELISIH_SO_RETUR_DO_RETUR) = 2 THEN '3/ 2 Hari'
	    WHEN ABS(SELISIH_SO_RETUR_DO_RETUR) = 3 THEN '4/ 3 Hari'
	    WHEN ABS(SELISIH_SO_RETUR_DO_RETUR) BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
	    WHEN ABS(SELISIH_SO_RETUR_DO_RETUR) BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
	    WHEN ABS(SELISIH_SO_RETUR_DO_RETUR) BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
	    WHEN ABS(SELISIH_SO_RETUR_DO_RETUR) > 30 THEN '8/ >30 Hari'
    ELSE ''
	END AS AGING_SO_RETUR_DO_RETUR	
FROM DO_ORI DR
LEFT JOIN STOCK_AGG O
	ON DR.SOURCE_SYSTEM = O.SOURCE_SYSTEM
	AND DR.DELIVERY_ORI = O.REFERENCE
	AND DR.MATERIAL_ORI = O.MATERIAL
LEFT JOIN STOCK_AGG R
	ON DR.SOURCE_SYSTEM = R.SOURCE_SYSTEM
	AND DR.DELIVERY_RETUR = R.REFERENCE
	AND DR.MATERIAL_RETUR = R.MATERIAL
LEFT JOIN POD_AGG POD
    ON DR.SOURCE_SYSTEM = POD.SOURCE_SYSTEM
    AND DR.DELIVERY_ORI = POD.DELIVERY_NUMBER
    AND DR.MATERIAL_ORI = POD.MATERIAL
