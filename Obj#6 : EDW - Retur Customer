WITH DO_RETUR AS (
	SELECT  DISTINCT 
		DO.SOURCE_SYSTEM ,
		DO.DELIVERY_NUMBER AS DELIVERY_RETUR,
		DO.DELIVERY_TYPE AS DELIVERY_RETUR_TYPE,
		DO.DELIVERY_TYPE_DESC AS DELIVERY_RETUR_TYPE_DESC,
		SO.SALES_ORDER_NUMBER AS SO_RETUR,
		SO.RETURN_REFERENCE_DOCUMENT_NUMBER AS BILLING_ORI,
		BO.BILLING_NUMBER AS BILLING_RETUR,
		BO.BILLING_CREATED_DATE
	FROM F_SALES_SALES_ORDER so
	LEFT JOIN F_SALES_BILLING bo ON so.SOURCE_SYSTEM = bo.SOURCE_SYSTEM AND so.SALES_ORDER_NUMBER = bo.REFERENCE_SALES_ORDER_NUMBER
	INNER JOIN F_SALES_DELIVERY do ON so.SOURCE_SYSTEM = do.SOURCE_SYSTEM AND so.SALES_ORDER_NUMBER = do.REFERENCE_SALES_ORDER_NUMBER AND SO.SALES_ORDER_ITEM = DO.REFERENCE_SALES_ORDER_ITEM
	WHERE (DO.DELIVERY_TYPE IN ('ZB51', 'ZB54', 'ZKR1','ZKR2','ZKRA') AND DO.SOURCE_SYSTEM = 'PE1') OR --DO Type Retur
	(DO.DELIVERY_TYPE IN ('ZKR1', 'ZKR2', 'ZKR5', 'ZKR6', 'ZKRA') AND DO.SOURCE_SYSTEM = 'PE2') --DO Type Retur
), DO_ORI AS (
	SELECT --retur
		DISTINCT
		DR.SOURCE_SYSTEM,
		--retur
		DR.SO_RETUR,
		DR.DELIVERY_RETUR,
		DR.DELIVERY_RETUR_TYPE ,
		DR.DELIVERY_RETUR_TYPE_DESC ,
		DR.BILLING_RETUR,
		--ori
		BO.REFERENCE_SALES_ORDER_NUMBER AS SO_ORI,
		BO.REFERENCE_DOCUMENT_NUMBER AS DELIVERY_ORI,
		DO.DELIVERY_TYPE AS DELIVERY_ORI_TYPE,
		DO.DELIVERY_TYPE_DESC AS DELIVERY_ORI_TYPE_DESC,
		DR.BILLING_ORI,
		DR.BILLING_CREATED_DATE
	FROM DO_RETUR DR 
	LEFT JOIN F_SALES_BILLING BO ON DR.SOURCE_SYSTEM = BO.SOURCE_SYSTEM AND DR.BILLING_ORI = BO.BILLING_NUMBER
	LEFT JOIN (SELECT 
					DISTINCT
					SOURCE_SYSTEM,
					DELIVERY_NUMBER,
					DELIVERY_TYPE, 
					DELIVERY_TYPE_DESC 
					FROM F_SALES_DELIVERY f 
	) DO ON BO.SOURCE_SYSTEM = DO.SOURCE_SYSTEM AND BO.REFERENCE_DOCUMENT_NUMBER = DO.DELIVERY_NUMBER
	
	UNION ALL
	
	SELECT --qty tolakan, PE1 only
		DO.SOURCE_SYSTEM,
		--RETUR NULL BECAUSE TOLAKAN ONLY ORI
		NULL AS SO_RETUR,
		NULL AS DELIVERY_RETUR,
		NULL AS DELIVERY_RETUR_TYPE, 
		NULL AS DELIVERY_RETUR_TYPE_DESC,
		NULL AS BILLING_RETUR,
		--ORI
		BO.REFERENCE_SALES_ORDER_NUMBER AS SO_ORI,
		DO.DELIVERY_NUMBER AS DELIVERY_ORI,
		DO.DELIVERY_TYPE AS DELIVERY_ORI_TYPE,
		DO.DELIVERY_TYPE_DESC AS DELIVERY_ORI_TYPE_DESC,
		BO.BILLING_NUMBER AS BILLING_ORI,
		BO.BILLING_CREATED_DATE
	FROM F_SALES_BILLING BO
	INNER JOIN (
	SELECT 
		DISTINCT 
		DO.SOURCE_SYSTEM,
		DO.DELIVERY_NUMBER ,
		DO.DELIVERY_TYPE,
		DO.DELIVERY_TYPE_DESC
	FROM F_SALES_DELIVERY DO 
	WHERE DO.DELIVERY_TYPE IN ('ZB01', 'ZB02', 'ZB05', 'ZB04', 'ZKD1', 'ZKD4', 'ZKD9', 'ZKDA', 'ZKDE') AND do.SOURCE_SYSTEM = 'PE1'
	) DO ON BO.SOURCE_SYSTEM = DO.SOURCE_SYSTEM AND BO.REFERENCE_DOCUMENT_NUMBER = DO.DELIVERY_NUMBER
),/* MOVEMENT MAPPING */ 
	MVT_MAP AS (
	SELECT
		COLUMN1 AS SOURCE_SYSTEM,
		COLUMN2 AS MOVEMENT_TYPE,
		COLUMN3 AS METRIC
	FROM VALUES
	/* DELIVERED */
	('PE1','601','DELIVERED_QTY'),
	('PE1','602','DELIVERED_QTY'),
	('PE2','633','DELIVERED_QTY'),
	('PE2','634','DELIVERED_QTY'),
	/* POD */
	('PE1','Z07','POD_QTY'),
	('PE1','Z08','POD_QTY'),
	/* TOLAKAN */
	('PE1','Z19','QTY_TOLAKAN'),
	('PE1','Z20','QTY_TOLAKAN'),
	/* RETURN POST SALES PE1 */
	('PE1','657','QTY_RETUR_POST_SALES'),
	('PE1','658','QTY_RETUR_POST_SALES'),
	('PE1','655','QTY_RETUR_POST_SALES'),
	('PE1','656','QTY_RETUR_POST_SALES'),
	('PE1','653','QTY_RETUR_POST_SALES'),
	('PE1','654','QTY_RETUR_POST_SALES'),
	/* RETURN POST SALES PE2 */
	('PE2','655','QTY_RETUR_POST_SALES'),
	('PE2','656','QTY_RETUR_POST_SALES'),
	('PE2','657','QTY_RETUR_POST_SALES'),
	('PE2','658','QTY_RETUR_POST_SALES'),
	('PE2','653','QTY_RETUR_POST_SALES'),
	('PE2','654','QTY_RETUR_POST_SALES'),
	('PE2','632','QTY_RETUR_POST_SALES'),
	('PE2','633','QTY_RETUR_POST_SALES')
),
/* AGGREGATE STOCK */
STOCK_AGG AS (
	SELECT
		S.SOURCE_SYSTEM,
		S.REFERENCE,
		S.BASE_UOM,
		M.METRIC,
		SUM(CASE WHEN M.METRIC='DELIVERED_QTY'
			THEN S.SIGNED_QUANTITY_FOR_BALANCE END) AS DELIVERED_QTY,
		SUM(CASE WHEN M.METRIC='POD_QTY'
			THEN S.SIGNED_QUANTITY_FOR_BALANCE END) AS POD_QTY,
		SUM(CASE WHEN M.METRIC='QTY_TOLAKAN'
			THEN S.SIGNED_QUANTITY_FOR_BALANCE END) AS QTY_TOLAKAN,
		SUM(CASE WHEN M.METRIC='QTY_RETUR_POST_SALES'
			THEN S.SIGNED_QUANTITY_FOR_BALANCE END) AS QTY_RETUR_POST_SALES
	FROM F_SCM_STOCK_TRANSACTION_SAP S
	LEFT JOIN MVT_MAP M
		ON S.SOURCE_SYSTEM = M.SOURCE_SYSTEM
		AND S.MOVEMENT_TYPE = M.MOVEMENT_TYPE
	WHERE ITEM_AUTOMATICALLY_CREATED IS NULL
	GROUP BY ALL
)
SELECT
	D.*,
	/* ORIGINAL DELIVERY */
	O.DELIVERED_QTY AS ORI_DELIVERED_QTY,
	O.POD_QTY AS ORI_POD_QTY,
	O.QTY_TOLAKAN AS ORI_QTY_TOLAKAN,
	O.BASE_UOM AS BASE_UOM_ORI,
	/* RETURN DELIVERY */
	R.QTY_RETUR_POST_SALES AS RETUR_QTY_POST_SALES,
	R.BASE_UOM AS BASE_UOM_RETUR
FROM DO_ORI D
LEFT JOIN STOCK_AGG O
	ON D.SOURCE_SYSTEM = O.SOURCE_SYSTEM
	AND D.DELIVERY_ORI = O.REFERENCE
LEFT JOIN STOCK_AGG R
	ON D.SOURCE_SYSTEM = R.SOURCE_SYSTEM
	AND D.DELIVERY_RETUR = R.REFERENCE
;
