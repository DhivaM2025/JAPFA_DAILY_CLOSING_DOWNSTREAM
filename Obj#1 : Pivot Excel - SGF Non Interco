    Query1[POD_STATUS] = "C-Completely processed";
    NOT ISBLANK(Query1[BILL_NUMBER]);
    TRIM(Query1[BILL_NUMBER]) <> "";
    Query1[TFTG_TYPE] = "TF";
    Query1[DISTRIBUTION_CHANNEL] = "01-Modern Trade"
)

# Count SO Number yang Billing Clearing Number Not Blank
