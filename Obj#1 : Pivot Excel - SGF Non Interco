    NOT ISBLANK(Query1[BILL_CLEARING_NUMBER])
)

# Count Billing Clearing MT
=CALCULATE(
    DISTINCTCOUNT(Query1[SO_NUMBER]);
    Query1[SALES_ORDER_STATUS_REJECTION] <> "C-Completely rejected";
