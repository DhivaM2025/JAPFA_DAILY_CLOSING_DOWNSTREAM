-- ============================================================
-- OPTIMIZED: SALES AMOUNT DASHBOARD - PE1
-- HOW TO USE: Edit ONLY the PARAMS CTE (5 values below).
--             All branches update automatically.
-- ============================================================
WITH PARAMS AS (
    SELECT
        '20260601'    AS V_DATE_FROM,   -- ← Start date (YYYYMMDD)
        '20260614'    AS V_DATE_TO,     -- ← End date   (YYYYMMDD)
        'PE1'         AS V_SOURCE,      -- ← Source system
        'ID90'        AS V_COMPANY,     -- ← Company code
        'Non Interco' AS V_TYPE         -- ← Type filter (set to NULL to disable)
),
-- Pre-compute cleared SO set (by SO number) — replaces 4x correlated EXISTS in SO/DO/GI branches
-- DEDUPED by REFERENCE_SALES_ORDER_NUMBER only to prevent join fanout
CTE_CLEARED_SO AS (
    SELECT DISTINCT SB.SOURCE_SYSTEM, SB.REFERENCE_SALES_ORDER_NUMBER
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_BILLING SB
    JOIN PROD_DB.DSTR_BI_COMMUNITY.F_SALES_BILLING_CLEARING SBC
        ON SB.SOURCE_SYSTEM = SBC.SOURCE_SYSTEM AND SB.BILLING_NUMBER = SBC.BILLING_NUMBER
    WHERE SB.SOURCE_SYSTEM = (SELECT V_SOURCE FROM PARAMS)
      AND SBC.BILLING_CLEARING_DOC IS NOT NULL AND SBC.BILLING_CLEARING_DOC <> ''
),
-- Pre-compute cleared billing (by billing number) — replaces correlated EXISTS in Billing branch
CTE_CLEARED_BILL AS (
    SELECT DISTINCT SOURCE_SYSTEM, BILLING_NUMBER
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_BILLING_CLEARING
    WHERE SOURCE_SYSTEM = (SELECT V_SOURCE FROM PARAMS)
      AND BILLING_CLEARING_DOC IS NOT NULL AND BILLING_CLEARING_DOC <> ''
),
-- Pre-compute interco SO lookup — replaces 4x inline SO1 subqueries
CTE_SO_INTERCO AS (
    SELECT DISTINCT SALES_ORDER_EXTERNAL_DOCUMENT, SALES_ORDER_NUMBER, SALES_ORDER_TYPE
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_SALES_ORDER
    WHERE SOURCE_SYSTEM = (SELECT V_SOURCE FROM PARAMS)
      AND SALES_ORDER_TYPE NOT IN ('ZKS3','ZKSC','ZKR3','ZKRC','ZKD3','ZKDC')
      AND SALES_ORDER_EXTERNAL_DOCUMENT IS NOT NULL
),
-- Pre-compute SO dimension (full history) — replaces 4x inline SO subqueries + outer A-level SO join
CTE_SO_LOOKUP AS (
    SELECT DISTINCT
        SOURCE_SYSTEM, COMPANY_CODE, SALES_ORDER_NUMBER, SALES_ORDER_TYPE, SALES_ORDER_TYPE_DESC,
        SALES_ORDER_STATUS, SALES_ORDER_STATUS_DESC,
        SALES_ORDER_STATUS_REJECTION, SALES_ORDER_STATUS_REJECTION_DESC,
        SALES_ORDER_STATUS_DELIVERY, SALES_ORDER_STATUS_DELIVERY_DESC,
        SALES_ORDER_STATUS_BILLING,  SALES_ORDER_STATUS_BILLING_DESC,
        SALES_ORDER_CREATED_DATE, SALES_ORDER_DATE, SALES_ORDER_EXTERNAL_DOCUMENT,
        CUSTOMER, PLANT, SALES_OFFICE, DIVISION, DIVISION_DESC, DISTRIBUTION_CHANNEL
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_SALES_ORDER
    WHERE SOURCE_SYSTEM = (SELECT V_SOURCE  FROM PARAMS)
      AND COMPANY_CODE  = (SELECT V_COMPANY FROM PARAMS)
),
-- Date-filtered SO facts — reduces 41M → ~864K rows for SO branch
CTE_SO_BASE AS (
    SELECT
        SOURCE_SYSTEM, COMPANY_CODE, SALES_ORDER_NUMBER, SALES_ORDER_TYPE, SALES_ORDER_TYPE_DESC,
        SALES_ORDER_STATUS, SALES_ORDER_STATUS_DESC,
        SALES_ORDER_STATUS_REJECTION, SALES_ORDER_STATUS_REJECTION_DESC,
        SALES_ORDER_CREATED_DATE, SALES_ORDER_DATE,
        SALES_ORDER_NEGATIVE_FLAG, SALES_ORDER_QUANTITY_IN_KG, SALES_ORDER_NET_AMOUNT,
        SALES_ORDER_EXTERNAL_DOCUMENT, CUSTOMER, PLANT
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_SALES_ORDER
    WHERE SOURCE_SYSTEM            = (SELECT V_SOURCE   FROM PARAMS)
      AND COMPANY_CODE             = (SELECT V_COMPANY  FROM PARAMS)
      AND SALES_ORDER_CREATED_DATE BETWEEN (SELECT V_DATE_FROM FROM PARAMS)	AND (SELECT V_DATE_TO   FROM PARAMS)
      AND PLANT NOT IN ('901A','905A','90VA','90VB','90VC','90WA','90XA','90ZA')
),
-- Delivery lookup (compact) — replaces 2x inline SD subqueries in GI and Billing branches
CTE_DELIVERY_LOOKUP AS (
    SELECT DISTINCT SOURCE_SYSTEM, DELIVERY_NUMBER, REFERENCE_SALES_ORDER_NUMBER,
                    DELIVERY_POD_STATUS, DELIVERY_NOTE
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_DELIVERY
    WHERE SOURCE_SYSTEM = (SELECT V_SOURCE FROM PARAMS)
),
-- Billing clearing per billing number — replaces inline SBC subquery in A-level join
CTE_BILLING_CLEARING AS (
    SELECT DISTINCT SOURCE_SYSTEM, BILLING_NUMBER, BILLING_CLEARING_DOC, BILLING_CLEAR_CREATED_DATE
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_BILLING_CLEARING
    WHERE SOURCE_SYSTEM = (SELECT V_SOURCE FROM PARAMS)
),
-- Billing summary per SO — replaces outer SB aggregation join (one scan instead of two)
CTE_BILLING_OUTER AS (
    SELECT SOURCE_SYSTEM, BILLING_NUMBER, REFERENCE_SALES_ORDER_NUMBER,
           TERM_OF_PAYMENT, TERM_OF_PAYMENT_DESC, BILLING_TYPE, BILLING_DATE,
           SUM(BILLING_NET_AMOUNT) AS TOTAL_BILLING_AMOUNT
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_BILLING
    WHERE SOURCE_SYSTEM = (SELECT V_SOURCE FROM PARAMS)
      AND BILLING_TYPE NOT IN ('ZB50','ZB99')
    GROUP BY SOURCE_SYSTEM, BILLING_NUMBER, REFERENCE_SALES_ORDER_NUMBER,
             TERM_OF_PAYMENT, TERM_OF_PAYMENT_DESC, BILLING_TYPE, BILLING_DATE
),
-- ============================================================
-- BRANCH 1: Sales Order
-- Source: CTE_SO_BASE (already date-filtered, 41M → ~864K rows)
-- ============================================================
CTE_BRANCH_SO AS (
    SELECT
        'Sales Order' AS CATEGORY,
        CASE WHEN SO.SALES_ORDER_TYPE='ZB20' AND SO.PLANT='90HA'     THEN 'Interco Automation MT'
             WHEN SO.SALES_ORDER_TYPE='ZKS9' AND SO.PLANT LIKE '85%' THEN 'Interco Automation B2B'
             WHEN SO.SALES_ORDER_TYPE='ZKSE' AND SO.PLANT LIKE '87%' THEN 'Interco Automation B2B VAM'
             ELSE 'Non Interco' END AS TYPE,
        SO.SALES_ORDER_TYPE||'-'||SO.SALES_ORDER_TYPE_DESC AS DOCUMENT_TYPE,
        NULL AS TFTG_TYPE, NULL AS PENGIRIMAN_CATEGORY,
        CASE WHEN SO.SALES_ORDER_STATUS IS NULL OR SO.SALES_ORDER_STATUS_DESC IS NULL
                  THEN SO.SALES_ORDER_STATUS_DESC
             ELSE SO.SALES_ORDER_STATUS||'-'||SO.SALES_ORDER_STATUS_DESC END AS DOCUMENT_STATUS,
        SO.SALES_ORDER_STATUS_REJECTION||'-'||SO.SALES_ORDER_STATUS_REJECTION_DESC AS REJECTION_STATUS,
        NULL AS POD_STATUS, NULL AS REASON_POD, NULL AS REASON_POD_FLAG,
        SO.SALES_ORDER_NUMBER AS SALES_ORDER_NUMBER,
        CASE WHEN SO.SALES_ORDER_TYPE='ZB20' AND SO.PLANT='90HA'     THEN SO1.SALES_ORDER_NUMBER
             WHEN SO.SALES_ORDER_TYPE='ZKS9' AND SO.PLANT LIKE '85%' THEN SO1.SALES_ORDER_NUMBER
             WHEN SO.SALES_ORDER_TYPE='ZKSE' AND SO.PLANT LIKE '87%' THEN SO1.SALES_ORDER_NUMBER
             ELSE SO.SALES_ORDER_EXTERNAL_DOCUMENT END AS SALES_ORDER_INTERCO_AUTOMATION,
        NULL AS DELIVERY_NUMBER, NULL AS GI_NUMBER, NULL AS BILLING_NUMBER,
        NULL AS TFTG_NUMBER, NULL AS BILL_CLEARING_NUMBER,
        TRY_TO_DATE(SO.SALES_ORDER_CREATED_DATE,'YYYYMMDD') AS SO_CREATED_DATE,
        TRY_TO_DATE(SO.SALES_ORDER_CREATED_DATE,'YYYYMMDD') AS CREATED_DATE,
        TRY_TO_DATE(SO.SALES_ORDER_DATE,'YYYYMMDD')         AS DOC_DATE,
        NULL AS CURRENCY,
        SUM(SO.SALES_ORDER_NEGATIVE_FLAG*SO.SALES_ORDER_QUANTITY_IN_KG) AS SO_QTY_IN_KG,
        SUM(SO.SALES_ORDER_NEGATIVE_FLAG*SO.SALES_ORDER_NET_AMOUNT)     AS SO_AMOUNT,
        0 AS DO_QTY_IN_KG, 0 AS GI_QTY_BASE_UOM, 0 AS GI_AMOUNT, 0 AS BILL_QTY_IN_KG, 0 AS BILL_AMOUNT,
        CASE WHEN CLR.REFERENCE_SALES_ORDER_NUMBER IS NOT NULL THEN 'X' ELSE NULL END AS BILLING_CLEAR_FLAG,
        SO.SOURCE_SYSTEM
    FROM CTE_SO_BASE SO
    LEFT JOIN CTE_SO_INTERCO SO1
        ON SO1.SALES_ORDER_EXTERNAL_DOCUMENT = SO.SALES_ORDER_NUMBER
    LEFT JOIN CTE_CLEARED_SO CLR
        ON CLR.SOURCE_SYSTEM = SO.SOURCE_SYSTEM
       AND CLR.REFERENCE_SALES_ORDER_NUMBER = SO.SALES_ORDER_NUMBER
    GROUP BY
        SO.SOURCE_SYSTEM, SO.SALES_ORDER_TYPE, SO.SALES_ORDER_TYPE_DESC,
        SO.SALES_ORDER_STATUS, SO.SALES_ORDER_STATUS_DESC,
        SO.SALES_ORDER_STATUS_REJECTION, SO.SALES_ORDER_STATUS_REJECTION_DESC,
        SO.SALES_ORDER_NUMBER, SO1.SALES_ORDER_NUMBER, SO.SALES_ORDER_EXTERNAL_DOCUMENT,
        SO.SALES_ORDER_CREATED_DATE, SO.SALES_ORDER_DATE,
        SO.CUSTOMER, SO.PLANT,
        CLR.REFERENCE_SALES_ORDER_NUMBER  -- 1:1 with SO.SALES_ORDER_NUMBER, no fanout risk
),
-- ============================================================
-- BRANCH 2: Delivery Order
-- ============================================================
CTE_BRANCH_DO AS (
    SELECT
        'Delivery Order' AS CATEGORY,
        CASE WHEN SO.SALES_ORDER_TYPE='ZB20' AND SO.PLANT='90HA'     THEN 'Interco Automation MT'
             WHEN SO.SALES_ORDER_TYPE='ZKS9' AND SO.PLANT LIKE '85%' THEN 'Interco Automation B2B'
             WHEN SO.SALES_ORDER_TYPE='ZKSE' AND SO.PLANT LIKE '87%' THEN 'Interco Automation B2B VAM'
             ELSE 'Non Interco' END AS TYPE,
        SD.DELIVERY_TYPE||'-'||SD.DELIVERY_TYPE_DESC AS DOCUMENT_TYPE,
        NULL AS TFTG_TYPE,
        CASE WHEN (SD.DELIVERY_TYPE='ZB04' AND SO.PLANT||SO.DIVISION IN (
                    '90EI01','90EF02','90AF01','90BB03','90EB02','90AD01','90ED01',
                    '90EH01','90EO02','90AL02','90AB01','90EC01','90BB02','90AD02',
                    '90AB02','90AF02','90BB01','90EE02','90EC02','90ED02','90EG01',
                    '90EL01','90EK01','90EI02','90AL01'))
              OR (SD.DELIVERY_TYPE='ZB05' AND SO.PLANT||SO.DIVISION IN (
                    '90AB02','90EO02','90ED01','90AF01','90EB02','90EF02','90EI01',
                    '90AB01','90AD02','90AD01','90BB01','90EC02','90EI02','90BB02',
                    '90AF02','90AL01','90EE02','90AL02','90ED02'))
             THEN 'Pengiriman Third Party Gudang Third Party'
             ELSE 'Pengiriman Third Party Gudang Internal' END AS PENGIRIMAN_CATEGORY,
        CASE WHEN SD.DELIVERY_STATUS='Not yet processed'    THEN 'A-Not yet processed'
             WHEN SD.DELIVERY_STATUS='Partially processed'  THEN 'B-Partially processed'
             WHEN SD.DELIVERY_STATUS='Completely processed' THEN 'C-Completely processed'
             ELSE SD.DELIVERY_STATUS END AS DOCUMENT_STATUS,
        SO.SALES_ORDER_STATUS_REJECTION||'-'||SO.SALES_ORDER_STATUS_REJECTION_DESC AS REJECTION_STATUS,
        CASE WHEN SD.DELIVERY_POD_STATUS='Not yet processed'    THEN 'A-Not yet processed'
             WHEN SD.DELIVERY_POD_STATUS='Partially processed'  THEN 'B-Partially processed'
             WHEN SD.DELIVERY_POD_STATUS='Completely processed' THEN 'C-Completely processed'
             ELSE SD.DELIVERY_POD_STATUS END AS POD_STATUS,
        SD.DELIVERY_NOTE AS REASON_POD,
        CASE WHEN SD.DELIVERY_NOTE IS NULL OR SD.DELIVERY_NOTE='' THEN FALSE ELSE TRUE END AS REASON_POD_FLAG,
        SD.REFERENCE_SALES_ORDER_NUMBER AS SALES_ORDER_NUMBER,
        CASE WHEN SO.SALES_ORDER_TYPE='ZB20' AND SO.PLANT='90HA'     THEN SO1.SALES_ORDER_NUMBER
             WHEN SO.SALES_ORDER_TYPE='ZKS9' AND SO.PLANT LIKE '85%' THEN SO1.SALES_ORDER_NUMBER
             WHEN SO.SALES_ORDER_TYPE='ZKSE' AND SO.PLANT LIKE '87%' THEN SO1.SALES_ORDER_NUMBER
             ELSE SO.SALES_ORDER_EXTERNAL_DOCUMENT END AS SALES_ORDER_INTERCO_AUTOMATION,
        SD.DELIVERY_NUMBER, NULL AS GI_NUMBER, NULL AS BILLING_NUMBER,
        NULL AS TFTG_NUMBER, NULL AS BILL_CLEARING_NUMBER,
        TRY_TO_DATE(SO.SALES_ORDER_CREATED_DATE,'YYYYMMDD') AS SO_CREATED_DATE,
        TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD')    AS CREATED_DATE,
        TRY_TO_DATE(SD.DELIVERY_ACTUAL_DATE,'YYYYMMDD')     AS DOC_DATE,
        NULL AS CURRENCY, 0 AS SO_QTY_IN_KG, 0 AS SO_AMOUNT,
        ROUND(SUM(SD.DELIVERY_QUANTITY_IN_KG),2) AS DO_QTY_IN_KG,
        0 AS GI_QTY_BASE_UOM, 0 AS GI_AMOUNT, 0 AS BILL_QTY_IN_KG, 0 AS BILL_AMOUNT,
        CASE WHEN CLR.REFERENCE_SALES_ORDER_NUMBER IS NOT NULL THEN 'X' ELSE NULL END AS BILLING_CLEAR_FLAG,
        SO.SOURCE_SYSTEM
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_DELIVERY SD
    LEFT JOIN CTE_SO_LOOKUP SO
        ON SO.SOURCE_SYSTEM = SD.SOURCE_SYSTEM AND SO.SALES_ORDER_NUMBER = SD.REFERENCE_SALES_ORDER_NUMBER
    LEFT JOIN CTE_SO_INTERCO SO1
        ON SO1.SALES_ORDER_EXTERNAL_DOCUMENT = SO.SALES_ORDER_NUMBER
    LEFT JOIN CTE_CLEARED_SO CLR
        ON CLR.SOURCE_SYSTEM = SO.SOURCE_SYSTEM
       AND CLR.REFERENCE_SALES_ORDER_NUMBER = SD.REFERENCE_SALES_ORDER_NUMBER
    WHERE SD.SOURCE_SYSTEM = (SELECT V_SOURCE FROM PARAMS)
    GROUP BY
        SD.DELIVERY_NUMBER, SD.REFERENCE_SALES_ORDER_NUMBER, SO.SALES_ORDER_EXTERNAL_DOCUMENT,
        SO1.SALES_ORDER_NUMBER, SD.DELIVERY_TYPE, SO.PLANT, SD.DELIVERY_TYPE_DESC,
        SD.DELIVERY_NOTE, SD.DELIVERY_STATUS, SO.SALES_ORDER_STATUS_REJECTION,
        SD.DELIVERY_POD_STATUS, SO.SALES_ORDER_STATUS_REJECTION_DESC,
        SO.SOURCE_SYSTEM, SO.SALES_ORDER_NUMBER, SO.SALES_ORDER_STATUS_DELIVERY,
        SO.SALES_ORDER_STATUS_DELIVERY_DESC, SO.SALES_ORDER_TYPE,
        SO.CUSTOMER, SO.PLANT, SO.DIVISION,
        SO.SALES_ORDER_CREATED_DATE, SD.DELIVERY_CREATED_DATE, SD.DELIVERY_ACTUAL_DATE,
        CLR.REFERENCE_SALES_ORDER_NUMBER  -- 1:1 with SD.REFERENCE_SALES_ORDER_NUMBER, no fanout risk
),
-- ============================================================
-- BRANCH 3: Good Issue
-- FIX: POSTING_DATE filter reduces 151M → ~762K rows
-- SO_CREATED_DATE kept NULL (GI rows excluded by outer WHERE as per original)
-- ============================================================
CTE_BRANCH_GI AS (
    SELECT
        'Good Issue' AS CATEGORY,
        CASE WHEN SO.SALES_ORDER_TYPE='ZB20' AND SO.PLANT='90HA'     THEN 'Interco Automation MT'
             WHEN SO.SALES_ORDER_TYPE='ZKS9' AND SO.PLANT LIKE '85%' THEN 'Interco Automation B2B'
             WHEN SO.SALES_ORDER_TYPE='ZKSE' AND SO.PLANT LIKE '87%' THEN 'Interco Automation B2B VAM'
             ELSE 'Non Interco' END AS TYPE,
        NULL AS DOCUMENT_TYPE, NULL AS TFTG_TYPE, NULL AS PENGIRIMAN_CATEGORY, NULL AS DOCUMENT_STATUS,
        SO.SALES_ORDER_STATUS_REJECTION||'-'||SO.SALES_ORDER_STATUS_REJECTION_DESC AS REJECTION_STATUS,
        CASE WHEN SD.DELIVERY_POD_STATUS='Not yet processed'    THEN 'A-Not yet processed'
             WHEN SD.DELIVERY_POD_STATUS='Partially processed'  THEN 'B-Partially processed'
             WHEN SD.DELIVERY_POD_STATUS='Completely processed' THEN 'C-Completely processed'
             ELSE SD.DELIVERY_POD_STATUS END AS POD_STATUS,
        SD.DELIVERY_NOTE AS REASON_POD,
        CASE WHEN SD.DELIVERY_NOTE IS NULL OR SD.DELIVERY_NOTE='' THEN FALSE ELSE TRUE END AS REASON_POD_FLAG,
        SO.SALES_ORDER_NUMBER AS SALES_ORDER_NUMBER,
        CASE WHEN SO.SALES_ORDER_TYPE='ZB20' AND SO.PLANT='90HA'     THEN SO1.SALES_ORDER_NUMBER
             WHEN SO.SALES_ORDER_TYPE='ZKS9' AND SO.PLANT LIKE '85%' THEN SO1.SALES_ORDER_NUMBER
             WHEN SO.SALES_ORDER_TYPE='ZKSE' AND SO.PLANT LIKE '87%' THEN SO1.SALES_ORDER_NUMBER
             ELSE SO.SALES_ORDER_EXTERNAL_DOCUMENT END AS SALES_ORDER_INTERCO_AUTOMATION,
        NULL AS DELIVERY_NUMBER,
        SCM.MATERIAL_DOCUMENT_NUMBER AS GI_NUMBER,
        NULL AS BILLING_NUMBER, NULL AS TFTG_NUMBER, NULL AS BILL_CLEARING_NUMBER,
        NULL AS SO_CREATED_DATE,  -- Kept NULL: GI rows excluded by outer WHERE (same as original)
        TRY_TO_DATE(SCM.ENTRY_DATE,   'YYYYMMDD') AS CREATED_DATE,
        TRY_TO_DATE(SCM.POSTING_DATE, 'YYYYMMDD') AS DOC_DATE,
        NULL AS CURRENCY, 0 AS SO_QTY_IN_KG, 0 AS SO_AMOUNT, 0 AS DO_QTY_IN_KG,
        ROUND(SUM(SCM.QUANTITY),2)     AS GI_QTY_BASE_UOM,
        ROUND(SUM(SCM.AMOUNT_IN_LC),2) AS GI_AMOUNT,
        0 AS BILL_QTY_IN_KG, 0 AS BILL_AMOUNT,
        CASE WHEN CLR.REFERENCE_SALES_ORDER_NUMBER IS NOT NULL THEN 'X' ELSE NULL END AS BILLING_CLEAR_FLAG,
        SCM.SOURCE_SYSTEM
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SCM_STOCK_TRANSACTION_SAP SCM
    LEFT JOIN CTE_DELIVERY_LOOKUP SD
        ON SD.SOURCE_SYSTEM = SCM.SOURCE_SYSTEM AND SD.DELIVERY_NUMBER = SCM."REFERENCE"
    LEFT JOIN CTE_SO_LOOKUP SO
        ON SO.SOURCE_SYSTEM = SD.SOURCE_SYSTEM AND SO.SALES_ORDER_NUMBER = SD.REFERENCE_SALES_ORDER_NUMBER
    LEFT JOIN CTE_SO_INTERCO SO1
        ON SO1.SALES_ORDER_EXTERNAL_DOCUMENT = SO.SALES_ORDER_NUMBER
    LEFT JOIN CTE_CLEARED_SO CLR
        ON CLR.SOURCE_SYSTEM = SO.SOURCE_SYSTEM
       AND CLR.REFERENCE_SALES_ORDER_NUMBER = SO.SALES_ORDER_NUMBER
    WHERE SCM.SOURCE_SYSTEM = (SELECT V_SOURCE FROM PARAMS)
      AND SCM.POSTING_DATE  BETWEEN (SELECT V_DATE_FROM FROM PARAMS)
                                AND (SELECT V_DATE_TO   FROM PARAMS)
    GROUP BY
        SCM.MATERIAL_DOCUMENT_NUMBER, SCM.ENTRY_DATE, SCM.POSTING_DATE,
        SD.DELIVERY_POD_STATUS, SO.SALES_ORDER_EXTERNAL_DOCUMENT, SO1.SALES_ORDER_NUMBER,
        SO.SOURCE_SYSTEM, SO.PLANT, SO.SALES_ORDER_NUMBER,
        SO.SALES_ORDER_STATUS_DELIVERY, SO.SALES_ORDER_STATUS_REJECTION,
        SO.SALES_ORDER_STATUS_DELIVERY_DESC, SO.SALES_ORDER_STATUS_REJECTION_DESC,
        SO.SALES_ORDER_TYPE, SD.DELIVERY_NOTE, SO.CUSTOMER, SO.SALES_ORDER_CREATED_DATE,
        SCM.SOURCE_SYSTEM,
        CLR.REFERENCE_SALES_ORDER_NUMBER  -- 1:1 with SO.SALES_ORDER_NUMBER, no fanout risk
),
-- ============================================================
-- BRANCH 4: Billing
-- Uses CTE_CLEARED_BILL (by BILLING_NUMBER) instead of CTE_CLEARED_SO
-- ============================================================
CTE_BRANCH_BILLING AS (
    SELECT
        'Billing' AS CATEGORY,
        CASE WHEN SO.SALES_ORDER_TYPE='ZB20' AND SO.PLANT='90HA'     THEN 'Interco Automation MT'
             WHEN SO.SALES_ORDER_TYPE='ZKS9' AND SO.PLANT LIKE '85%' THEN 'Interco Automation B2B'
             WHEN SO.SALES_ORDER_TYPE='ZKSE' AND SO.PLANT LIKE '87%' THEN 'Interco Automation B2B VAM'
             ELSE 'Non Interco' END AS TYPE,
        SB.BILLING_TYPE||'-'||SB.BILLING_TYPE_DESC AS DOCUMENT_TYPE,
        TTF.TTF_DOC_TYPE AS TFTG_TYPE, NULL AS PENGIRIMAN_CATEGORY,
        CASE WHEN SB.POSTING_STATUS IS NULL OR SB.POSTING_STATUS_DESCRIPTION IS NULL
                  THEN SB.POSTING_STATUS_DESCRIPTION
             ELSE SB.POSTING_STATUS||'-'||SB.POSTING_STATUS_DESCRIPTION END AS DOCUMENT_STATUS,
        SO.SALES_ORDER_STATUS_REJECTION||'-'||SO.SALES_ORDER_STATUS_REJECTION_DESC AS REJECTION_STATUS,
        CASE WHEN SD.DELIVERY_POD_STATUS='Not yet processed'    THEN 'A-Not yet processed'
             WHEN SD.DELIVERY_POD_STATUS='Partially processed'  THEN 'B-Partially processed'
             WHEN SD.DELIVERY_POD_STATUS='Completely processed' THEN 'C-Completely processed'
             ELSE SD.DELIVERY_POD_STATUS END AS POD_STATUS,
        SD.DELIVERY_NOTE AS REASON_POD,
        CASE WHEN SD.DELIVERY_NOTE IS NULL OR SD.DELIVERY_NOTE='' THEN FALSE ELSE TRUE END AS REASON_POD_FLAG,
        SB.REFERENCE_SALES_ORDER_NUMBER AS SALES_ORDER_NUMBER,
        CASE WHEN SO.SALES_ORDER_TYPE='ZB20' AND SO.PLANT='90HA'     THEN SO1.SALES_ORDER_NUMBER
             WHEN SO.SALES_ORDER_TYPE='ZKS9' AND SO.PLANT LIKE '85%' THEN SO1.SALES_ORDER_NUMBER
             WHEN SO.SALES_ORDER_TYPE='ZKSE' AND SO.PLANT LIKE '87%' THEN SO1.SALES_ORDER_NUMBER
             ELSE SO.SALES_ORDER_EXTERNAL_DOCUMENT END AS SALES_ORDER_INTERCO_AUTOMATION,
        NULL AS DELIVERY_NUMBER, NULL AS GI_NUMBER,
        SB.BILLING_NUMBER,
        TTF.TTF_NUMBER AS TFTG_NUMBER,
        SBC.BILLING_CLEARING_DOC AS BILL_CLEARING_NUMBER,
        TRY_TO_DATE(SO.SALES_ORDER_CREATED_DATE,'YYYYMMDD') AS SO_CREATED_DATE,
        TRY_TO_DATE(SB.BILLING_CREATED_DATE,'YYYYMMDD')     AS CREATED_DATE,
        TRY_TO_DATE(SB.BILLING_DATE,'YYYYMMDD')             AS DOC_DATE,
        SB.BILLING_DOCUMENT_CURRENCY AS CURRENCY,
        0 AS SO_QTY_IN_KG, 0 AS SO_AMOUNT, 0 AS DO_QTY_IN_KG, 0 AS GI_QTY_BASE_UOM, 0 AS GI_AMOUNT,
        ROUND(SUM(SB.BILLING_NEGATIVE_FLAG*SB.BILLING_QUANTITY_IN_KG),2) AS BILL_QTY_IN_KG,
        ROUND(SUM(SB.BILLING_NEGATIVE_FLAG*SB.BILLING_NET_AMOUNT),2)     AS BILL_AMOUNT,
        CASE WHEN CLR.BILLING_NUMBER IS NOT NULL THEN 'X' ELSE NULL END AS BILLING_CLEAR_FLAG,
        SB.SOURCE_SYSTEM
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_BILLING SB
    LEFT JOIN CTE_SO_LOOKUP SO
        ON SO.SOURCE_SYSTEM = SB.SOURCE_SYSTEM AND SO.SALES_ORDER_NUMBER = SB.REFERENCE_SALES_ORDER_NUMBER
    LEFT JOIN CTE_SO_INTERCO SO1
        ON SO1.SALES_ORDER_EXTERNAL_DOCUMENT = SO.SALES_ORDER_NUMBER
    LEFT JOIN CTE_DELIVERY_LOOKUP SD
        ON SD.SOURCE_SYSTEM = SO.SOURCE_SYSTEM AND SD.REFERENCE_SALES_ORDER_NUMBER = SO.SALES_ORDER_NUMBER
    LEFT JOIN CTE_BILLING_CLEARING SBC
        ON SBC.SOURCE_SYSTEM = SB.SOURCE_SYSTEM AND SBC.BILLING_NUMBER = SB.BILLING_NUMBER
    LEFT JOIN PROD_DB.DSTR_BI_COMMUNITY.F_SALES_BILLING_TTF TTF
        ON TTF.SOURCE_SYSTEM = SB.SOURCE_SYSTEM AND TTF.BILLING_NUMBER = SB.BILLING_NUMBER
    LEFT JOIN CTE_CLEARED_BILL CLR                          -- uses billing-level cleared CTE
        ON CLR.SOURCE_SYSTEM = SB.SOURCE_SYSTEM AND CLR.BILLING_NUMBER = SB.BILLING_NUMBER
    WHERE SB.SOURCE_SYSTEM = (SELECT V_SOURCE FROM PARAMS)
      AND SB.BILLING_TYPE <> 'ZB50'
    GROUP BY
        SB.BILLING_TYPE, SB.BILLING_TYPE_DESC, TTF.TTF_DOC_TYPE, SB.SOURCE_SYSTEM, SO.PLANT,
        SB.POSTING_STATUS, SD.DELIVERY_POD_STATUS, SB.POSTING_STATUS_DESCRIPTION,
        SO.SALES_ORDER_STATUS_BILLING, SO.SALES_ORDER_STATUS_REJECTION,
        SO.SALES_ORDER_STATUS_BILLING_DESC, SO.SALES_ORDER_STATUS_REJECTION_DESC,
        SO.SALES_ORDER_TYPE, SD.DELIVERY_NOTE, SO.CUSTOMER,
        SB.REFERENCE_SALES_ORDER_NUMBER, SO.SALES_ORDER_EXTERNAL_DOCUMENT, SO1.SALES_ORDER_NUMBER,
        SB.BILLING_NUMBER, SO.SALES_ORDER_CREATED_DATE, SB.BILLING_CREATED_DATE,
        SB.BILLING_DATE, SB.BILLING_DOCUMENT_CURRENCY,
        TTF.TTF_NUMBER, SBC.BILLING_CLEARING_DOC,
        CLR.BILLING_NUMBER  -- 1:1 with SB.BILLING_NUMBER, no fanout risk
),
-- Combine all 4 branches
CTE_UNION AS (
    SELECT * FROM CTE_BRANCH_SO
    UNION ALL SELECT * FROM CTE_BRANCH_DO
    UNION ALL SELECT * FROM CTE_BRANCH_GI
    UNION ALL SELECT * FROM CTE_BRANCH_BILLING
),
-- A-level: dimension joins + flag computations (mirrors original A subquery)
CTE_A AS (
    SELECT DISTINCT
        SO.SOURCE_SYSTEM,
        SO.COMPANY_CODE||'-'||CP.COMPANY_NAME AS COMPANY,
        SO.CUSTOMER                            AS CUSTOMER_SO_CODE,
        CUST.CUSTOMER_NAME                     AS CUSTOMER_SO_NAME,
        SO.PLANT||'-'||CP1.PLANT_NAME          AS PLANT,
		CASE 
			WHEN LEFT(SO.SALES_OFFICE,2) IN ('85','87') THEN SO.SALES_OFFICE
            WHEN A_CUST.SALES_OFFICE IS NOT NULL THEN A_CUST.SALES_OFFICE
			ELSE SO.SALES_OFFICE 
		END AS FINAL_SALES_OFFICE,
        SO.DIVISION||'-'||SO.DIVISION_DESC                             AS DIVISION,
        SO.DISTRIBUTION_CHANNEL||'-'||SA_DC.DISTRIBUTION_CHANNEL_DESC AS DISTRIBUTION_CHANNEL,
        CUST.REGION||'-'||DSR.REGION_DESCRIPTION                      AS REGION,
        CASE WHEN DSR.REGION IN ('01','02','03','04','05','28') THEN 'PULAU JAWA'
             ELSE 'LUAR JAWA' END AS STATUS_REGION,
        CASE WHEN SB.TERM_OF_PAYMENT_DESC IS NULL OR SB.TERM_OF_PAYMENT=''
                  THEN SB.TERM_OF_PAYMENT
             ELSE SB.TERM_OF_PAYMENT||'-'||SB.TERM_OF_PAYMENT_DESC END AS TOP,
        CASE WHEN SB.TERM_OF_PAYMENT IN ('TCOD','TCBD') THEN 0
             ELSE COALESCE(TRY_TO_NUMBER(RIGHT(SB.TERM_OF_PAYMENT,2)),0) END AS PAYMENT_TERM_DAYS,
        CASE WHEN SB.BILLING_DATE IS NOT NULL AND PAYMENT_TERM_DAYS IS NULL
                  THEN TRY_TO_DATE(SB.BILLING_DATE,'YYYYMMDD')
             WHEN SB.BILLING_DATE IS NOT NULL AND PAYMENT_TERM_DAYS IS NOT NULL
                  THEN DATEADD(DAY,PAYMENT_TERM_DAYS,TRY_TO_DATE(SB.BILLING_DATE,'YYYYMMDD'))
             ELSE NULL END AS BILLING_DUE_DATE,
        CASE WHEN BILLING_DUE_DATE IS NOT NULL AND SBC.BILLING_CLEAR_CREATED_DATE IS NOT NULL THEN 'CLEARED'
             WHEN BILLING_DUE_DATE IS NOT NULL AND SBC.BILLING_CLEAR_CREATED_DATE IS NULL     THEN 'BELUM ADA CLEARING'
             WHEN BILLING_DUE_DATE IS NULL     AND SBC.BILLING_CLEAR_CREATED_DATE IS NULL     THEN 'BELUM ADA BILLING'
             ELSE 'N/A' END AS CLEARED_FLAG,
        CASE WHEN BILLING_DUE_DATE IS NOT NULL AND TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD') IS NOT NULL
                  AND TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD') <= BILLING_DUE_DATE THEN 'CLEARED - ON TIME'
             WHEN BILLING_DUE_DATE IS NOT NULL AND TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD') IS NOT NULL
                  AND TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD') >  BILLING_DUE_DATE THEN 'CLEARED - OVERDUE'
             WHEN BILLING_DUE_DATE IS NOT NULL AND TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD') IS NULL
                  AND CURRENT_DATE >= BILLING_DUE_DATE THEN 'SUDAH JATUH TEMPO'
             WHEN BILLING_DUE_DATE IS NOT NULL AND TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD') IS NULL
                  AND CURRENT_DATE <  BILLING_DUE_DATE THEN 'BELUM JATUH TEMPO'
             ELSE 'N/A' END AS JATUH_TEMPO_FLAG,
        CASE WHEN SB.TOTAL_BILLING_AMOUNT=0 THEN TRUE ELSE FALSE END AS AMOUNT_ZERO_FLAG,
        X.CATEGORY, X.TYPE, X.DOCUMENT_TYPE, X.TFTG_TYPE, X.PENGIRIMAN_CATEGORY,
        X.DOCUMENT_STATUS, X.REJECTION_STATUS, X.POD_STATUS, X.REASON_POD, X.REASON_POD_FLAG,
        X.SALES_ORDER_NUMBER, X.SALES_ORDER_INTERCO_AUTOMATION, X.DELIVERY_NUMBER,
        X.GI_NUMBER, X.BILLING_NUMBER, X.TFTG_NUMBER, X.BILL_CLEARING_NUMBER,
        X.SO_CREATED_DATE, X.CREATED_DATE, X.DOC_DATE, X.CURRENCY,
        X.SO_QTY_IN_KG, X.SO_AMOUNT, X.DO_QTY_IN_KG, X.GI_QTY_BASE_UOM,
        X.GI_AMOUNT, X.BILL_QTY_IN_KG, X.BILL_AMOUNT, X.BILLING_CLEAR_FLAG
    FROM CTE_UNION X
    LEFT JOIN CTE_SO_LOOKUP SO
        ON SO.SALES_ORDER_NUMBER = X.SALES_ORDER_NUMBER
    LEFT JOIN CTE_BILLING_OUTER SB
        ON SB.REFERENCE_SALES_ORDER_NUMBER = X.SALES_ORDER_NUMBER
    LEFT JOIN CTE_BILLING_CLEARING SBC
        ON SBC.BILLING_NUMBER = X.BILLING_NUMBER
    LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM, CUSTOMER, CUSTOMER_NAME, REGION, COUNTRY
               FROM PROD_DB.DSTR_BI_COMMUNITY.D_SALES_CUSTOMER) CUST
        ON CUST.SOURCE_SYSTEM = SO.SOURCE_SYSTEM AND CUST.CUSTOMER = SO.CUSTOMER
    LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM, COMPANY_CODE, COMPANY_NAME
               FROM PROD_DB.DSTR_BI_COMMUNITY.D_SCM_COMPANY_AND_PLANT) CP
        ON CP.SOURCE_SYSTEM = SO.SOURCE_SYSTEM AND CP.COMPANY_CODE = SO.COMPANY_CODE
    LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM, PLANT, PLANT_NAME
               FROM PROD_DB.DSTR_BI_COMMUNITY.D_SCM_COMPANY_AND_PLANT) CP1
        ON CP1.SOURCE_SYSTEM = SO.SOURCE_SYSTEM AND CP1.PLANT = SO.PLANT
    LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM, DISTRIBUTION_CHANNEL, DISTRIBUTION_CHANNEL_DESC
               FROM PROD_DB.DSTR_BI_COMMUNITY.D_SALES_AREA) SA_DC
        ON SA_DC.SOURCE_SYSTEM = SO.SOURCE_SYSTEM AND SA_DC.DISTRIBUTION_CHANNEL = SO.DISTRIBUTION_CHANNEL
    LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM, REGION, REGION_DESCRIPTION, COUNTRY
               FROM PROD_DB.DSTR_BI_COMMUNITY.D_SALES_REGION) DSR
        ON DSR.SOURCE_SYSTEM = CUST.SOURCE_SYSTEM AND DSR.REGION = CUST.REGION AND DSR.COUNTRY = CUST.COUNTRY
    LEFT JOIN (
        SELECT SOURCE_SYSTEM, CUSTOMER, SALES_OFFICE, SALES_OFFICE_DESC,
               ROW_NUMBER() OVER (PARTITION BY CUSTOMER ORDER BY SALES_OFFICE ASC) AS RN
        FROM PROD_DB.DSTR_BI_COMMUNITY.D_SALES_CUSTOMER
        WHERE BLOCK_FOR_SALES='Non block' AND DELETION_FOR_SALES='Non delete'
          AND SOURCE_SYSTEM=(SELECT V_SOURCE FROM PARAMS)
          AND LEFT(SALES_OFFICE,2) NOT IN ('85','87') AND SALES_OFFICE NOT IN ('9001','90HA')
    ) A_CUST
        ON A_CUST.SOURCE_SYSTEM = SO.SOURCE_SYSTEM AND A_CUST.CUSTOMER = SO.CUSTOMER AND A_CUST.RN = 1
    	WHERE SO.PLANT NOT IN ('901A','905A','90VA','90VB','90VC','90WA','90XA','90ZA')
)
-- Final SELECT: SALES_OFFICE join mirrors original outermost SELECT
SELECT
    A.SOURCE_SYSTEM, A.COMPANY, A.CUSTOMER_SO_CODE, A.CUSTOMER_SO_NAME, A.PLANT,
    A.FINAL_SALES_OFFICE||'-'||SA.SALES_OFFICE_DESC AS SALES_OFFICE,
    CASE WHEN A.FINAL_SALES_OFFICE LIKE '87%' THEN 'B2B VAM'
         WHEN A.FINAL_SALES_OFFICE LIKE '85%' THEN 'B2B'
         ELSE LEFT(SA.SALES_OFFICE_DESC,3) END AS SALES_OFFICE_GROUP,
    A.DIVISION, A.DISTRIBUTION_CHANNEL, A.REGION, A.STATUS_REGION, A.TOP, A.AMOUNT_ZERO_FLAG,
    A.CATEGORY, A.TYPE, A.DOCUMENT_TYPE, A.TFTG_TYPE, A.PENGIRIMAN_CATEGORY,
    A.DOCUMENT_STATUS, A.REJECTION_STATUS, A.POD_STATUS, A.REASON_POD, A.REASON_POD_FLAG,
    A.CLEARED_FLAG, A.JATUH_TEMPO_FLAG,
    A.SALES_ORDER_NUMBER, A.SALES_ORDER_INTERCO_AUTOMATION, A.DELIVERY_NUMBER,
    A.GI_NUMBER, A.BILLING_NUMBER, A.TFTG_NUMBER, A.BILL_CLEARING_NUMBER,
    A.SO_CREATED_DATE, A.CREATED_DATE, A.DOC_DATE, A.BILLING_DUE_DATE, A.CURRENCY,
    A.SO_QTY_IN_KG, A.SO_AMOUNT, A.DO_QTY_IN_KG, A.GI_QTY_BASE_UOM,
    A.GI_AMOUNT, A.BILL_QTY_IN_KG, A.BILL_AMOUNT, A.BILLING_CLEAR_FLAG
FROM CTE_A A
LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM, COMPANY_CODE, SALES_OFFICE, SALES_OFFICE_DESC
           FROM PROD_DB.DSTR_BI_COMMUNITY.D_SALES_AREA) SA
    ON SA.SOURCE_SYSTEM = A.SOURCE_SYSTEM
   AND SA.COMPANY_CODE  = LEFT(A.COMPANY,4)
   AND SA.SALES_OFFICE  = A.FINAL_SALES_OFFICE
WHERE 
	A.SO_CREATED_DATE BETWEEN TRY_TO_DATE((SELECT V_DATE_FROM FROM PARAMS),'YYYYMMDD') AND TRY_TO_DATE((SELECT V_DATE_TO   FROM PARAMS),'YYYYMMDD')
  	AND ((SELECT V_TYPE FROM PARAMS) IS NULL OR A.TYPE = (SELECT V_TYPE FROM PARAMS))
  	--AND A.SALES_ORDER_NUMBER IN ('1208327389','1208327390')
ORDER BY
    A.SALES_ORDER_NUMBER    ASC,
    A.DELIVERY_NUMBER       DESC,
    A.GI_NUMBER             DESC,
    A.BILLING_NUMBER        DESC,
    A.TFTG_NUMBER           ASC,
    A.BILL_CLEARING_NUMBER  ASC
;
