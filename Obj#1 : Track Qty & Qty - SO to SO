WITH so_qty AS (
    SELECT 
        f.SOURCE_SYSTEM,
        f.SALES_ORDER_NUMBER,
        f.SALES_OFFICE,
        S.SALES_OFFICE_DESC ,
       	f.SALES_ORDER_CREATED_DATE,
       	f.SALES_ORDER_TYPE,
       	f.SALES_ORDER_STATUS,
       	f.SALES_ORDER_STATUS_DESC,
       	f.SALES_ORDER_STATUS_REJECTION,
       	f.SALES_ORDER_STATUS_REJECTION_DESC,
       	f.CUSTOMER ,
       	s.CUSTOMER_NAME ,
       	f.COMPANY_CODE ,
       	d.COMPANY_NAME ,
       	f.DISTRIBUTION_CHANNEL ,
       	r.REGION_DESCRIPTION AS CUSTOMER_REGION,
       	f.PLANT || '-' || p.PLANT_NAME AS PLANT,
        f.BASE_UOM,
        SUM(f.SALES_ORDER_QUANTITY_IN_BASE_UOM) AS SALES_ORDER_QTY_BASE,
        SUM(f.SALES_ORDER_QUANTITY_IN_KG)        AS SALES_ORDER_QTY_KG
    FROM F_SALES_SALES_ORDER f
    LEFT JOIN D_SALES_CUSTOMER s 
     ON f.SOURCE_SYSTEM = s.SOURCE_SYSTEM 
     AND  f.CUSTOMER = s.CUSTOMER 
     AND  f.Sales_Organization = s.Sales_Organization 
     AND  f.Distribution_Channel = s.Distribution_Channel 
     and f.Division = s.Sales_Division
    LEFT JOIN D_SALES_REGION r
     ON s.SOURCE_SYSTEM = r.SOURCE_SYSTEM
     AND s.COUNTRY = r.COUNTRY
     AND s.REGION = r.REGION
    LEFT JOIN D_SCM_COMPANY d
     ON f.SOURCE_SYSTEM = d.SOURCE_SYSTEM
     AND f.COMPANY_CODE = d.COMPANY_CODE
    LEFT JOIN D_SCM_PLANT p 
     ON f.SOURCE_SYSTEM = p.SOURCE_SYSTEM
     AND f.COMPANY_CODE = p.COMPANY_CODE
     AND f.PLANT = p.PLANT
    GROUP BY
        ALL
), sel AS (
	SELECT DISTINCT
		f.FLAG ,
		f.SOURCE_SYSTEM ,
		f.SALES_ORDER_NUMBER
	FROM F_SALES_INTERCO_HEADER f
	WHERE f.SALES_ORDER_EXTERNAL_DOCUMENT IS NULL
), pro AS (
	SELECT DISTINCT 
		f.FLAG,
		f.SOURCE_SYSTEM,
		f.SALES_ORDER_NUMBER,
		f.SALES_ORDER_EXTERNAL_DOCUMENT 
	FROM F_SALES_INTERCO_HEADER f
	WHERE f.SALES_ORDER_EXTERNAL_DOCUMENT IS NOT NULL
), final_q AS (
    SELECT
        /* SELLING ENTITY */
        sel.SOURCE_SYSTEM              AS SEL_SOURCE_SYSTEM,
        sel.SALES_ORDER_NUMBER         AS SEL_SALES_ORDER,
        qs.SALES_OFFICE				   AS SEL_SALES_OFFICE,
        qs.SALES_OFFICE_DESC		   AS SEL_SALES_OFFICE_DESC,
        qs.SALES_ORDER_TYPE			   AS SEL_SALES_ORDER_TYPE,
        qs.SALES_ORDER_STATUS 		   AS SEL_SALES_ORDER_STATUS,
        qs.SALES_ORDER_STATUS_DESC	   AS SEL_SALES_ORDER_STATUS_DESC,
        qs.SALES_ORDER_STATUS_REJECTION			AS SEL_SALES_ORDER_STATUS_REJECTION,
        qs.SALES_ORDER_STATUS_REJECTION_DESC 	AS SEL_SALES_ORDER_STATUS_REJECTION_DESC,
        qs.CUSTOMER AS SEL_CUSTOMER,
       	qs.CUSTOMER_NAME AS SEL_CUSTOMER_NAME,
       	qs.COMPANY_CODE AS SEL_COMPANY_CODE,
       	qs.COMPANY_NAME AS SEL_COMPANY_NAME,
       	qs.DISTRIBUTION_CHANNEL AS SEL_DISTRIBUTION_CHANNEL,
       	qs.CUSTOMER_REGION AS SEL_CUSTOMER_REGION,
       	qs.PLANT AS SEL_PLANT,
        qs.BASE_UOM AS SEL_BASE_UOM,
        qs.SALES_ORDER_QTY_BASE        AS SEL_QTY_BASE,
        qs.SALES_ORDER_QTY_KG          AS SEL_QTY_KG,

        /* PRODUCTION ENTITY */
        pro.SOURCE_SYSTEM              AS PRO_SOURCE_SYSTEM,
        pro.SALES_ORDER_NUMBER         AS PRO_SALES_ORDER,
        qp.SALES_OFFICE				   AS PRO_SALES_OFFICE,
        qp.SALES_OFFICE_DESC		   AS PRO_SALES_OFFICE_DESC,
        qp.SALES_ORDER_TYPE			   AS PRO_SALES_ORDER_TYPE,
        qp.SALES_ORDER_STATUS 		   AS PRO_SALES_ORDER_STATUS,
        qp.SALES_ORDER_STATUS_DESC	   AS PRO_SALES_ORDER_STATUS_DESC,
        qp.SALES_ORDER_STATUS_REJECTION			AS PRO_SALES_ORDER_STATUS_REJECTION,
        qp.SALES_ORDER_STATUS_REJECTION_DESC 	AS PRO_SALES_ORDER_STATUS_REJECTION_DESC,
        qp.CUSTOMER AS PRO_CUSTOMER,
       	qp.CUSTOMER_NAME AS PRO_CUSTOMER_NAME,
       	qp.COMPANY_CODE AS PRO_COMPANY_CODE,
       	qp.COMPANY_NAME AS PRO_COMPANY_NAME,
       	qp.DISTRIBUTION_CHANNEL AS PRO_DISTRIBUTION_CHANNEL,
       	qp.CUSTOMER_REGION AS PRO_CUSTOMER_REGION,
       	qp.PLANT AS PRO_PLANT,
        qp.BASE_UOM AS PRO_BASE_UOM,
        qp.SALES_ORDER_QTY_BASE        AS PRO_QTY_BASE,
        qp.SALES_ORDER_QTY_KG          AS PRO_QTY_KG,

        CASE
        WHEN sel.SALES_ORDER_NUMBER IS NOT NULL
         AND pro.SALES_ORDER_EXTERNAL_DOCUMENT IS NOT NULL
            THEN 'MATCH'
        WHEN sel.SALES_ORDER_NUMBER IS NOT NULL
         AND pro.SALES_ORDER_EXTERNAL_DOCUMENT IS NULL
            THEN 'SEL_ONLY'
        WHEN sel.SALES_ORDER_NUMBER IS NULL
         AND pro.SALES_ORDER_EXTERNAL_DOCUMENT IS NOT NULL
            THEN 'PRO_ONLY'
    	END AS SO_MATCH_STATUS
    FROM sel
    FULL OUTER JOIN pro
        ON pro.SALES_ORDER_EXTERNAL_DOCUMENT = sel.SALES_ORDER_NUMBER

    /* qty selling */
    LEFT JOIN so_qty qs
        ON qs.SALES_ORDER_NUMBER = sel.SALES_ORDER_NUMBER
       AND qs.SOURCE_SYSTEM     = sel.SOURCE_SYSTEM

    /* qty production */
    LEFT JOIN so_qty qp
        ON qp.SALES_ORDER_NUMBER = pro.SALES_ORDER_NUMBER
       AND qp.SOURCE_SYSTEM     = pro.SOURCE_SYSTEM
)
SELECT
    * 
    ,
    CASE
        WHEN SEL_QTY_KG IS NULL OR PRO_QTY_KG IS NULL
            THEN 'MISSING'
        WHEN ABS(SEL_QTY_KG - PRO_QTY_KG) = 0
            THEN 'MATCH'
        ELSE 'NOT_MATCH'
    END AS QTY_COMPARE_STATUS 
    FROM FINAL_Q
    
    ;
