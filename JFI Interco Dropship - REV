			WHEN BC.BILLING_CLEAR_CREATED_DATE IS NULL AND BLPROD.BILLING_DUE_DATE_INTERCO IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, CURRENT_DATE, BLPROD.BILLING_DUE_DATE_INTERCO))) 
