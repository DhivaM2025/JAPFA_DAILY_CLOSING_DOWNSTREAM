		    WHEN DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_POSTING_DATE,'YYYYMMDD')) < -30 THEN '6/ >30 Hari'
