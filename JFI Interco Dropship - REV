		CASE
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CLEARING_INTERCO = 'N/A' THEN 'N/A'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CLEARING_INTERCO = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CLEARING_INTERCO = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CLEARING_INTERCO = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CLEARING_INTERCO = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CLEARING_INTERCO BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CLEARING_INTERCO BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CLEARING_INTERCO BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CLEARING_INTERCO > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_BILLING_INTERCO_BILLING_CLEARING_INTERCO,
		-- BILLING INTERCO TO INVOICE RECEIPT --
		CASE 
			WHEN IR.INVOICE_RECEIPT_POSTING_DATE IS NULL AND BLPROD.BILLING_INTERCO_CREATED_DATE IS NULL THEN 'N/A' 
			WHEN IR.INVOICE_RECEIPT_POSTING_DATE IS NOT NULL AND BLPROD.BILLING_INTERCO_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, BLPROD.BILLING_INTERCO_CREATED_DATE, IR.INVOICE_RECEIPT_POSTING_DATE))) 
			WHEN IR.INVOICE_RECEIPT_POSTING_DATE IS NULL AND BLPROD.BILLING_INTERCO_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, BLPROD.BILLING_INTERCO_CREATED_DATE, CURRENT_DATE))) 
			ELSE 'N/A' 
		END AS SELISIH_BILLING_INTERCO_INVOICE_RECEIPT,
		CASE
		    WHEN SELISIH_BILLING_INTERCO_INVOICE_RECEIPT = 'N/A' THEN 'N/A'
		    WHEN SELISIH_BILLING_INTERCO_INVOICE_RECEIPT = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_BILLING_INTERCO_INVOICE_RECEIPT = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_BILLING_INTERCO_INVOICE_RECEIPT = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_BILLING_INTERCO_INVOICE_RECEIPT = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_BILLING_INTERCO_INVOICE_RECEIPT BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_BILLING_INTERCO_INVOICE_RECEIPT BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_BILLING_INTERCO_INVOICE_RECEIPT BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_BILLING_INTERCO_INVOICE_RECEIPT > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_BILLING_INTERCO_INVOICE_RECEIPT,
		-- SO CUSTOMER TO POD PROD ENTITY --
		CASE 
			WHEN DOPROD.POD_INTERCO_DATE IS NULL AND SO.SALES_ORDER_CREATED_DATE IS NULL THEN 'N/A' 
			WHEN DOPROD.POD_INTERCO_DATE IS NOT NULL AND SO.SALES_ORDER_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, SO.SALES_ORDER_CREATED_DATE, DOPROD.POD_INTERCO_DATE))) 
			WHEN DOPROD.POD_INTERCO_DATE IS NULL AND SO.SALES_ORDER_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, SO.SALES_ORDER_CREATED_DATE, CURRENT_DATE))) 
			ELSE 'N/A' 
		END AS SELISIH_SALES_ORDER_CUSTOMER_POD,
		CASE
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_POD = 'N/A' THEN 'N/A'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_POD = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_POD = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_POD = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_POD = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_POD BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_POD BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_POD BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_POD > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_SALES_ORDER_CUSTOMER_POD,
		-- SO CUSTOMER TO BILLING INTERCO --
		CASE 
			WHEN BLPROD.BILLING_INTERCO_CREATED_DATE IS NULL AND SO.SALES_ORDER_CREATED_DATE IS NULL THEN 'N/A' 
			WHEN BLPROD.BILLING_INTERCO_CREATED_DATE IS NOT NULL AND SO.SALES_ORDER_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, SO.SALES_ORDER_CREATED_DATE, BLPROD.BILLING_INTERCO_CREATED_DATE))) 
			WHEN BLPROD.BILLING_INTERCO_CREATED_DATE IS NULL AND SO.SALES_ORDER_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, SO.SALES_ORDER_CREATED_DATE, CURRENT_DATE))) 
			ELSE 'N/A' 
		END AS SELISIH_SALES_ORDER_CUSTOMER_BILLING_INTERCO,
		CASE
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_BILLING_INTERCO = 'N/A' THEN 'N/A'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_BILLING_INTERCO = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_BILLING_INTERCO = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_BILLING_INTERCO = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_BILLING_INTERCO = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_BILLING_INTERCO BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_BILLING_INTERCO BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_BILLING_INTERCO BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_SALES_ORDER_CUSTOMER_BILLING_INTERCO > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_SALES_ORDER_CUSTOMER_BILLING_INTERCO,
		-- POD DI PRODUCTION ENTITY TO BILLING CLEARING CUSTOMER --
		CASE 
			WHEN BC.BILLING_CLEAR_CREATED_DATE IS NULL AND DOPROD.POD_INTERCO_DATE IS NULL THEN 'N/A' 
			WHEN BC.BILLING_CLEAR_CREATED_DATE IS NOT NULL AND DOPROD.POD_INTERCO_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, DOPROD.POD_INTERCO_DATE, BC.BILLING_CLEAR_CREATED_DATE))) 
			WHEN BC.BILLING_CLEAR_CREATED_DATE IS NULL AND DOPROD.POD_INTERCO_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, DOPROD.POD_INTERCO_DATE, CURRENT_DATE))) 
			ELSE 'N/A' 
		END AS SELISIH_POD_BILLING_CLEARING_CUSTOMER,
		CASE
		    WHEN SELISIH_POD_BILLING_CLEARING_CUSTOMER = 'N/A' THEN 'N/A'
		    WHEN SELISIH_POD_BILLING_CLEARING_CUSTOMER = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_POD_BILLING_CLEARING_CUSTOMER = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_POD_BILLING_CLEARING_CUSTOMER = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_POD_BILLING_CLEARING_CUSTOMER = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_POD_BILLING_CLEARING_CUSTOMER BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_POD_BILLING_CLEARING_CUSTOMER BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_POD_BILLING_CLEARING_CUSTOMER BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_POD_BILLING_CLEARING_CUSTOMER > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_POD_BILLING_CLEARING_CUSTOMER,
		-- BACKDATE --
		-- GI INTERCO BACKDATE --
		SO.SO_BACKDATE_FLAG,
		SO.SO_DIFF_DAYS,
		SO.AGING_SO_DIFF_DAYS,
		SOPROD.SO_INTERCO_BACKDATE_FLAG,
		SOPROD.SO_INTERCO_DIFF_DAYS,
		SOPROD.AGING_SO_INTERCO_DIFF_DAYS,
		DF.DO_CONS_BACKDATE_FLAG,
		DF.DO_CONS_DIFF_DAYS,
		DF.AGING_DO_CONS_DIFF_DAYS,
		DF.GI_CONS_BACKDATE_FLAG,
		DF.GI_CONS_DIFF_DAYS,
		DF.AGING_GI_CONS_DIFF_DAYS,
		DOPROD.POD_BACKDATE_FLAG,
		DOPROD.POD_DIFF_DAYS,
		DOPROD.AGING_POD_DIFF_DAYS,
		BLPROD.BILLING_INTERCO_BACKDATE_FLAG,
		BLPROD.BILLING_INTERCO_DIFF_DAYS,
		BLPROD.AGING_BILLING_INTERCO_DIFF_DAYS,
		BL.BILLING_CUSTOMER_BACKDATE_FLAG,
		BL.BILLING_CUSTOMER_DIFF_DAYS,
		BL.AGING_BILLING_CUSTOMER_DIFF_DAYS,
		TF.TF_BACKDATE_FLAG,
		TF.TF_DIFF_DAYS,
		TF.AGING_TF_DIFF_DAYS,
		BC.BILLING_CLEARING_CUSTOMER_BACKDATE_FLAG,
		BC.BILLING_CLEARING_CUSTOMER_DIFF_DAYS,
		BC.AGING_BILLING_CLEARING_CUSTOMER_DIFF_DAYS
		-- TF/TG CUSTOMER BACKDATE --
	FROM HEADER H
	LEFT JOIN HEADER_PRODUCTION HP
		ON HP.SALES_ORDER_EXTERNAL_DOCUMENT = H.SALES_ORDER_NUMBER_CUSTOMER
	LEFT JOIN DOCUMENT_FLOW DF
		ON DF.SOURCE_SYSTEM = HP.SOURCE_SYSTEM
	AND DF.SALES_ORDER_NUMBER = HP.SALES_ORDER_NUMBER_INTERCO
	LEFT JOIN SO_DETAIL_SELLING SO
		ON SO.SOURCE_SYSTEM = H.SOURCE_SYSTEM
	AND SO.SALES_ORDER_NUMBER_CUSTOMER = H.SALES_ORDER_NUMBER_CUSTOMER
	LEFT JOIN SO_DETAIL_PRODUCTION SOPROD
		ON SOPROD.SOURCE_SYSTEM = HP.SOURCE_SYSTEM
	AND SOPROD.SALES_ORDER_NUMBER_INTERCO = HP.SALES_ORDER_NUMBER_INTERCO
	LEFT JOIN DO_DETAIL_SELLING DO
		ON DO.SOURCE_SYSTEM = H.SOURCE_SYSTEM
	AND DO.DELIVERY_NUMBER_CUSTOMER = H.DELIVERY_NUMBER_CUSTOMER
	LEFT JOIN DO_DETAIL_PRODUCTION DOPROD
		ON DOPROD.SOURCE_SYSTEM = HP.SOURCE_SYSTEM
		AND DOPROD.DELIVERY_NUMBER_INTERCO = HP.DELIVERY_NUMBER_INTERCO
	LEFT JOIN GI_DETAIL_SELLING GI
		ON GI.SOURCE_SYSTEM = H.SOURCE_SYSTEM
	AND GI.DELIVERY_NUMBER = H.DELIVERY_NUMBER_CUSTOMER
	LEFT JOIN GI_DETAIL_PRODUCTION GIPROD
		ON GIPROD.SOURCE_SYSTEM = HP.SOURCE_SYSTEM
	AND GIPROD.DELIVERY_NUMBER_INTERCO = HP.DELIVERY_NUMBER_INTERCO
	LEFT JOIN BILLING_DETAIL_SELLING BL
		ON BL.SOURCE_SYSTEM  = H.SOURCE_SYSTEM
	AND BL.BILLING_NUMBER_CUSTOMER = H.BILLING_NUMBER_CUSTOMER
	LEFT JOIN BILLING_DETAIL_PRODUCTION BLPROD
		ON BLPROD.SOURCE_SYSTEM = HP.SOURCE_SYSTEM
		AND BLPROD.BILLING_NUMBER_INTERCO = HP.BILLING_NUMBER_INTERCO 
	LEFT JOIN INVOICE_RECEIPT IR
		ON IR.SOURCE_SYSTEM = H.SOURCE_SYSTEM
		AND IR.DOCUMENT_NUMBER = H.INVOICE_NUMBER
	LEFT JOIN TF_DETAIL_SELLING TF
		ON TF.SOURCE_SYSTEM  = H.SOURCE_SYSTEM
	AND TF.BILLING_NUMBER_CUSTOMER = H.BILLING_NUMBER_CUSTOMER
	LEFT JOIN TF_DETAIL_PRODUCTION TFPROD
		ON TFPROD.SOURCE_SYSTEM  = HP.SOURCE_SYSTEM
	AND TFPROD.BILLING_NUMBER_INTERCO = HP.BILLING_NUMBER_INTERCO 
	LEFT JOIN BILLING_CLEARING_DETAIL_SELLING BC
		ON BC.SOURCE_SYSTEM  = H.SOURCE_SYSTEM
	AND BC.BILLING_NUMBER_CUSTOMER = H.BILLING_NUMBER_CUSTOMER
	LEFT JOIN BILLING_CLEARING_DETAIL_PRODUCTION BCPROD
		ON BCPROD.SOURCE_SYSTEM = HP.SOURCE_SYSTEM
		AND BCPROD.BILLING_NUMBER_INTERCO = HP.BILLING_NUMBER_INTERCO 
)
/*P50_CALC AS (
    SELECT
        CREDIT_OWNER,
        PERCENTILE_CONT(0.5) WITHIN GROUP (
            ORDER BY IFF(SELISIH_SO_CUSTOMER_SO_INTERCO = 'N/A', NULL, TRY_TO_NUMBER(SELISIH_SO_CUSTOMER_SO_INTERCO)) ASC
        ) AS P50_SO_CUSTOMER_SO_INTERCO,
        PERCENTILE_CONT(0.5) WITHIN GROUP (
            ORDER BY IFF(SELISIH_SO_INTERCO_DO_CONS = 'N/A', NULL, TRY_TO_NUMBER(SELISIH_SO_INTERCO_DO_CONS)) ASC
        ) AS P50_SO_INTERCO_DO_CONS,
        PERCENTILE_CONT(0.5) WITHIN GROUP (
            ORDER BY IFF(SELISIH_GI_CONS_POD_INTERCO = 'N/A', NULL, TRY_TO_NUMBER(SELISIH_GI_CONS_POD_INTERCO)) ASC
        ) AS P50_GI_CONS_POD_INTERCO,
        PERCENTILE_CONT(0.5) WITHIN GROUP (
            ORDER BY IFF(SELISIH_POD_INTERCO_BILLING_INTERCO = 'N/A', NULL, TRY_TO_NUMBER(SELISIH_POD_INTERCO_BILLING_INTERCO)) ASC
        ) AS P50_POD_INTERCO_BILLING_INTERCO,
        PERCENTILE_CONT(0.5) WITHIN GROUP (
            ORDER BY IFF(SELISIH_BILLING_INTERCO_BILLING_CUSTOMER = 'N/A', NULL, TRY_TO_NUMBER(SELISIH_BILLING_INTERCO_BILLING_CUSTOMER)) ASC
        ) AS P50_BILLING_INTERCO_BILLING_CUSTOMER,
        PERCENTILE_CONT(0.5) WITHIN GROUP (
            ORDER BY IFF(SELISIH_BILLING_CUSTOMER_TF_CUSTOMER = 'N/A', NULL, TRY_TO_NUMBER(SELISIH_BILLING_CUSTOMER_TF_CUSTOMER)) ASC
        ) AS P50_BILLING_CUSTOMER_TF_CUSTOMER,
        PERCENTILE_CONT(0.5) WITHIN GROUP (
            ORDER BY IFF(SELISIH_BILLING_INTERCO_TF_INTERCO = 'N/A', NULL, TRY_TO_NUMBER(SELISIH_BILLING_INTERCO_TF_INTERCO)) ASC
        ) AS P50_BILLING_INTERCO_TF_INTERCO,
        PERCENTILE_CONT(0.5) WITHIN GROUP (
            ORDER BY IFF(SELISIH_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER = 'N/A', NULL, TRY_TO_NUMBER(SELISIH_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER)) ASC
        ) AS P50_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER,
        PERCENTILE_CONT(0.5) WITHIN GROUP (
            ORDER BY IFF(SELISIH_BILLING_INTERCO_INVOICE_RECEIPT = 'N/A', NULL, TRY_TO_NUMBER(SELISIH_BILLING_INTERCO_INVOICE_RECEIPT)) ASC
        ) AS P50_BILLING_INTERCO_INVOICE_RECEIPT,
        PERCENTILE_CONT(0.5) WITHIN GROUP (
            ORDER BY IFF(SELISIH_POD_BILLING_CLEARING_CUSTOMER = 'N/A', NULL, TRY_TO_NUMBER(SELISIH_POD_BILLING_CLEARING_CUSTOMER)) ASC
        ) AS P50_POD_BILLING_CLEARING_CUSTOMER
    FROM (
        SELECT DISTINCT
            CREDIT_OWNER,
            SALES_ORDER_NUMBER_CUSTOMER,  -- grain utama untuk deduplikasi
            SELISIH_SO_CUSTOMER_SO_INTERCO,
            SELISIH_SO_INTERCO_DO_CONS,
            SELISIH_GI_CONS_POD_INTERCO,
            SELISIH_POD_INTERCO_BILLING_INTERCO,
            SELISIH_BILLING_INTERCO_BILLING_CUSTOMER,
            SELISIH_BILLING_CUSTOMER_TF_CUSTOMER,
            SELISIH_BILLING_INTERCO_TF_INTERCO,
            SELISIH_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER,
            SELISIH_BILLING_INTERCO_INVOICE_RECEIPT,
            SELISIH_POD_BILLING_CLEARING_CUSTOMER
        FROM AGGR
        WHERE CREDIT_OWNER IS NOT NULL
    ) DEDUP
    GROUP BY CREDIT_OWNER
)*/
SELECT 
	A.SOURCE_SYSTEM,
	A.COMPANY,
	A.PLANT,
	A.CUSTOMER,
	A.CUSTOMER_NAME,
	A.CREDIT_OWNER,
	A.CUSTOMER_SHIP_TO,
	A.CUSTOMER_SHIP_TO_NAME,
	A.REGION,
	A.REGION_GROUP,
	A.POD_FLAG,
	A.SALES_OFFICE || '-' || SA.SALES_OFFICE_DESC AS SALES_OFFICE,
	CASE 
		WHEN A.SALES_OFFICE LIKE '87%' THEN 'B2B VAM'
		WHEN A.SALES_OFFICE LIKE '85%' THEN 'B2B'
		ELSE 'MT - ' || LEFT (SA.SALES_OFFICE_DESC,3)
	END AS SALES_OFFICE_GROUP,
	A.DIVISION,
	A.DISTRIBUTION_CHANNEL,
	A.TERM_OF_PAYMENT,
	A.SALES_ORDER_CATEGORY,
	A.SALES_ORDER_TYPE,
	A.DELIVERY_TYPE,
	A.BILLING_TYPE,
	A.TF_DOC_TYPE,
	A.SALES_ORDER_STATUS,
	A.SALES_ORDER_STATUS_REJECTION,
