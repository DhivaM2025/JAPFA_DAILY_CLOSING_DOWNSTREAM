		    WHEN SD.DELIVERY_CREATED_DATE IS NOT NULL AND SD.DELIVERY_POSTING_DATE IS NOT NULL THEN TO_VARCHAR(DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_POSTING_DATE,'YYYYMMDD')))
		    ELSE 'N/A'
		END AS POD_DIFF_DAYS,
		CASE
		    WHEN SD.DELIVERY_CREATED_DATE IS NULL AND SD.DELIVERY_POSTING_DATE IS NULL THEN 'N/A'
		    WHEN DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_POSTING_DATE,'YYYYMMDD')) >= 0 THEN '1/ 0 Hari'
		    WHEN DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_POSTING_DATE,'YYYYMMDD')) BETWEEN -3 AND -1 THEN '2/ 1-3 Hari'
		    WHEN DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_POSTING_DATE,'YYYYMMDD')) BETWEEN -7 AND -4 THEN '3/ 3-7 Hari'
		    WHEN DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_POSTING_DATE,'YYYYMMDD')) BETWEEN -14 AND -8 THEN '4/ 7-14 Hari'
