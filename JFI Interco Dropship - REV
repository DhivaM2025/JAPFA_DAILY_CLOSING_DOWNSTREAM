		    WHEN DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_ACTUAL_DATE,'YYYYMMDD')) >= 0 THEN '1/ 0 Hari'
		    WHEN DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_ACTUAL_DATE,'YYYYMMDD')) BETWEEN -3 AND -1 THEN '2/ 1-3 Hari'
		    WHEN DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_ACTUAL_DATE,'YYYYMMDD')) BETWEEN -7 AND -4 THEN '3/ 3-7 Hari'
		    WHEN DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_ACTUAL_DATE,'YYYYMMDD')) BETWEEN -14 AND -8 THEN '4/ 7-14 Hari'
		    WHEN DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_ACTUAL_DATE,'YYYYMMDD')) BETWEEN -30 AND -15 THEN '5/ 14-30 Hari'
		    WHEN DATEDIFF(DAY,TRY_TO_DATE(SD.DELIVERY_CREATED_DATE,'YYYYMMDD'),TRY_TO_DATE(SD.DELIVERY_ACTUAL_DATE,'YYYYMMDD')) < -30 THEN '6/ >30 Hari'
		    ELSE ''
		END AS AGING_DELIVERY_DIFF_DAYS,
		CASE 
		    WHEN SD.DELIVERY_CREATED_DATE IS NULL AND SD.DELIVERY_POSTING_DATE IS NULL THEN 'N/A'
		    WHEN SD.DELIVERY_CREATED_DATE IS NOT NULL AND SD.DELIVERY_POSTING_DATE IS NULL THEN 'Real-time entry'
