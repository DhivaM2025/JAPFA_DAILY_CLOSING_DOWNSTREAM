			WHEN SBC.BILLING_CLEAR_CREATED_DATE IS NOT NULL AND SBC.BILLING_CLEAR_DATE IS NOT NULL THEN TO_VARCHAR(DATEDIFF(DAY, TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD'), TRY_TO_DATE(SBC.BILLING_CLEAR_DATE,'YYYYMMDD')))
			ELSE 'N/A'
		END AS BILLING_CLEARING_CUSTOMER_DIFF_DAYS,
		CASE
		    WHEN SBC.BILLING_CLEAR_CREATED_DATE IS NULL AND SBC.BILLING_CLEAR_DATE IS NULL THEN 'N/A'
		    WHEN DATEDIFF(DAY, TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD'), TRY_TO_DATE(SBC.BILLING_CLEAR_DATE,'YYYYMMDD')) >= 0 THEN '1/ 0 Hari'
		    WHEN DATEDIFF(DAY, TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD'), TRY_TO_DATE(SBC.BILLING_CLEAR_DATE,'YYYYMMDD')) BETWEEN -3 AND -1 THEN '2/ 1-3 Hari'
		    WHEN DATEDIFF(DAY, TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD'), TRY_TO_DATE(SBC.BILLING_CLEAR_DATE,'YYYYMMDD')) BETWEEN -7 AND -4 THEN '3/ 3-7 Hari'
		    WHEN DATEDIFF(DAY, TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD'), TRY_TO_DATE(SBC.BILLING_CLEAR_DATE,'YYYYMMDD')) BETWEEN -14 AND -8 THEN '4/ 7-14 Hari'
		    WHEN DATEDIFF(DAY, TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD'), TRY_TO_DATE(SBC.BILLING_CLEAR_DATE,'YYYYMMDD')) BETWEEN -30 AND -15 THEN '5/ 14-30 Hari'
		    WHEN DATEDIFF(DAY, TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE,'YYYYMMDD'), TRY_TO_DATE(SBC.BILLING_CLEAR_DATE,'YYYYMMDD')) < -30 THEN '6/ >30 Hari'
		    ELSE ''
		END AS AGING_BILLING_CLEARING_CUSTOMER_DIFF_DAYS
	FROM HEADER H
	INNER JOIN PROD_DB.DSTR_BI_COMMUNITY.F_SALES_BILLING_CLEARING SBC
    ON SBC.SOURCE_SYSTEM = H.SOURCE_SYSTEM
    AND SBC.BILLING_NUMBER = H.BILLING_NUMBER_CUSTOMER
),
BILLING_CLEARING_DETAIL_PRODUCTION AS(
	SELECT DISTINCT
		HP.SOURCE_SYSTEM,
		HP.BILLING_NUMBER_INTERCO,
		SBC.BILLING_CLEARING_DOC AS BILLING_CLEARING_NUMBER_INTERCO,
		TRY_TO_DATE(SBC.BILLING_CLEAR_CREATED_DATE, 'YYYYMMDD') AS BILLING_CLEAR_INTERCO_CREATED_DATE,
		TRY_TO_DATE(SBC.BILLING_CLEAR_DATE, 'YYYYMMDD') AS BILLING_CLEAR_INTERCO_DATE,
	FROM HEADER_PRODUCTION HP
    INNER JOIN PROD_DB.DSTR_BI_COMMUNITY.F_SALES_BILLING_CLEARING SBC
		ON SBC.SOURCE_SYSTEM = HP.SOURCE_SYSTEM
		AND SBC.BILLING_NUMBER = HP.BILLING_NUMBER_INTERCO
),
AGGR AS (
	SELECT
		-- SELLING ENTITY --
		H.SOURCE_SYSTEM,
		SO.COMPANY,
		SO.PLANT,
		SO.CUSTOMER,
		SO.CUSTOMER_NAME,
		SO.CREDIT_OWNER,
		SO.CUSTOMER_SHIP_TO,
		SO.CUSTOMER_SHIP_TO_NAME,
		SO.REGION,
		SO.REGION_GROUP,
		SO.POD_FLAG,
		SO.SALES_OFFICE,
		SO.DIVISION,
		SO.DISTRIBUTION_CHANNEL,
		BL.TERM_OF_PAYMENT,
		SO.SALES_ORDER_CATEGORY,
		SO.SALES_ORDER_TYPE,
		DO.DELIVERY_TYPE,
		BL.BILLING_TYPE,
		TF.TF_DOC_TYPE,
		SO.SALES_ORDER_STATUS,
		SO.SALES_ORDER_STATUS_REJECTION,
		SO.SALES_ORDER_REASON_REJECTION_DESC,
		SO.SALES_ORDER_REASON_REJECTION_GROUP,
		DO.DELIVERY_STATUS,
		BL.BILLING_STATUS,
		-- SELLING DOC NUMBER --
		SO.CREATED_BY,
		H.SALES_ORDER_NUMBER_CUSTOMER,
		H.DELIVERY_NUMBER_CUSTOMER,
		GI.GI_NUMBER_CUSTOMER,
		H.BILLING_NUMBER_CUSTOMER,
		TF.TF_NUMBER_CUSTOMER,
		BC.BILLING_CLEARING_NUMBER_CUSTOMER,
		H.PO_NUMBER,
		H.GR_NUMBER,
		H.INVOICE_NUMBER,
		-- PRODUCTION DOC NUMBER --
		HP.SALES_ORDER_NUMBER_INTERCO,
		HP.DELIVERY_NUMBER_INTERCO,
		GIPROD.GI_NUMBER_INTERCO,
		DF.SALES_ORDER_CONS_NUMBER,
		DF.DELIVERY_CONS_NUMBER,
		DF.GI_CONS_NUMBER,
		HP.BILLING_NUMBER_INTERCO,
		TFPROD.TF_NUMBER_INTERCO,
		BCPROD.BILLING_CLEARING_NUMBER_INTERCO,
		-- PRODUCTION ENTITY --
		SOPROD.COMPANY_INTERCO,
		SOPROD.PLANT_INTERCO,
		SOPROD.SALES_OFFICE_INTERCO,
		SOPROD.DISTRIBUTION_CHANNEL_INTERCO,
		SOPROD.SALES_ORDER_INTERCO_TYPE,
		DOPROD.DELIVERY_INTERCO_TYPE,
		BLPROD.BILLING_INTERCO_TYPE,
		SOPROD.SALES_ORDER_INTERCO_STATUS,
		DF.SALES_ORDER_CONS_STATUS,
		SOPROD.SALES_ORDER_INTERCO_STATUS_REJECTION,
		SOPROD.SALES_ORDER_INTERCO_REASON_REJECTION_DESC,
		DOPROD.DELIVERY_INTERCO_STATUS,
		DOPROD.DELIVERY_INTERCO_POD_STATUS,
		BLPROD.BILLING_INTERCO_STATUS,
		CASE
			WHEN COALESCE(COALESCE (DOPROD.SALES_ORDER_REASON,DF.SALES_ORDER_REASON) || '-' || COALESCE (DOPROD.SALES_ORDER_REASON_DESC,DF.SALES_ORDER_REASON_DESC), '') = '' THEN FALSE
			ELSE TRUE
		END AS DELIVERY_INTERCO_REJECTION_FLAG,
		COALESCE (DOPROD.SALES_ORDER_REASON,DF.SALES_ORDER_REASON) || '-' || COALESCE (DOPROD.SALES_ORDER_REASON_DESC,DF.SALES_ORDER_REASON_DESC) AS DELIVERY_INTERCO_REJECTION_REASON,
		CASE
		WHEN
			COALESCE(DOPROD.SALES_ORDER_REASON, DF.SALES_ORDER_REASON) || '-' || COALESCE(DOPROD.SALES_ORDER_REASON_DESC, DF.SALES_ORDER_REASON_DESC)
			IN (
				'K00-(CAS)Ret Cons',
				'K01-(CAS)CN/DN Same Prd Qlty',
				'K02-(CAS)CN/DN Same Prd Non Qlty',
				'K03-(CAS)Ret Same Prd Qlty',
				'K04-(CAS)Ret Same Prd Non Qlty',
				'K07-(CAS)Ret Last Prd w/o Nota Qlty',
				'K08-(CAS)Ret Last Prd w/o Nota Non Qlty',
				'K09-(CAS)Ret With Nota Return',
				'K12-(CAS)Ret Same Prd Adm'
			)
		THEN 'Order Related'
		ELSE 'N/A'
		END AS DELIVERY_INTERCO_REJECTION_REASON_GROUPING,
		DF.DELIVERY_CONS_STATUS,
		-- SELLING DOC DATE --
		SO.SALES_ORDER_CREATED_DATE,
		SO.SALES_ORDER_DATE,
		BL.BILLING_CREATED_DATE,
		BL.BILLING_DATE,
		BL.BILLING_DUE_DATE,
		CASE
			WHEN BL.BILLING_DUE_DATE IS NULL THEN 'BILLING BELUM TERBUAT'
    		WHEN CURRENT_DATE <= BL.BILLING_DUE_DATE THEN 'BELUM JATUH TEMPO'        
			WHEN CURRENT_DATE > BL.BILLING_DUE_DATE THEN 'SUDAH JATUH TEMPO'
		END AS JATUH_TEMPO_FLAG,
		CASE
			WHEN BL.BILLING_DUE_DATE IS NOT NULL AND BC.BILLING_CLEAR_CREATED_DATE IS NULL AND CURRENT_DATE > BL.BILLING_DUE_DATE
			THEN 'BELUM ADA PEMBAYARAN'
			WHEN BL.BILLING_DUE_DATE IS NOT NULL AND BC.BILLING_CLEAR_CREATED_DATE IS NOT NULL AND BC.BILLING_CLEAR_CREATED_DATE > BL.BILLING_DUE_DATE
			THEN 'OVERDUE'
			WHEN BL.BILLING_DUE_DATE IS NOT NULL AND BC.BILLING_CLEAR_CREATED_DATE IS NOT NULL AND BC.BILLING_CLEAR_CREATED_DATE <= BL.BILLING_DUE_DATE
			THEN 'ON TIME'
			ELSE 'N/A'
		END AS OVERDUE_PAYMENT_FLAG,
		TF.TF_CUSTOMER_CREATED_DATE,
		TF.TF_CUSTOMER_DATE, 
		BC.BILLING_CLEAR_CREATED_DATE,
		BC.BILLING_CLEAR_DATE,
		IR.INVOICE_RECEIPT_POSTING_DATE,
		-- PRODUCTION DATE --
		SOPROD.SALES_ORDER_INTERCO_CREATED_DATE,
		SOPROD.SALES_ORDER_INTERCO_DATE,
		DOPROD.DELIVERY_INTERCO_CREATED_DATE,
		DOPROD.POD_INTERCO_DATE,
		GIPROD.GI_INTERCO_CREATED_DATE,
		BLPROD.BILLING_INTERCO_CREATED_DATE,
		TFPROD.TF_INTERCO_CREATED_DATE,
		TFPROD.TF_INTERCO_DATE,
		-- BLPROD.BILLING_INTERCO_DATE,
		BLPROD.BILLING_DUE_DATE_INTERCO,
		BCPROD.BILLING_CLEAR_INTERCO_CREATED_DATE,
		-- INTERCO CONSIGNMENT --
		DF.SALES_ORDER_CONS_CREATED_DATE,
		DF.DELIVERY_CONS_CREATED_DATE,
		-- DF.DELIVERY_CONS_ACTUAL_DATE,
		DF.GI_CONS_CREATED_DATE,
		-- DF.GI_CONS_DATE,
		-- OPEN ITEM AGING --
		-- SO CUSTOMER TO SO INTERCO --
		CASE
		    WHEN SOPROD.SALES_ORDER_INTERCO_CREATED_DATE IS NULL AND SO.SALES_ORDER_CREATED_DATE IS NULL THEN 'N/A'
		    WHEN SOPROD.SALES_ORDER_INTERCO_CREATED_DATE IS NOT NULL AND SO.SALES_ORDER_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, SO.SALES_ORDER_CREATED_DATE, SOPROD.SALES_ORDER_INTERCO_CREATED_DATE)))
		    WHEN SOPROD.SALES_ORDER_INTERCO_CREATED_DATE IS NULL AND SO.SALES_ORDER_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, SO.SALES_ORDER_CREATED_DATE, CURRENT_DATE)))
		    ELSE 'N/A'
		END AS SELISIH_SO_CUSTOMER_SO_INTERCO,
		CASE
		    WHEN SELISIH_SO_CUSTOMER_SO_INTERCO = 'N/A' THEN 'N/A'
		    WHEN SELISIH_SO_CUSTOMER_SO_INTERCO = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_SO_CUSTOMER_SO_INTERCO = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_SO_CUSTOMER_SO_INTERCO = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_SO_CUSTOMER_SO_INTERCO = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_SO_CUSTOMER_SO_INTERCO BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_SO_CUSTOMER_SO_INTERCO BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_SO_CUSTOMER_SO_INTERCO BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_SO_CUSTOMER_SO_INTERCO > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_SO_CUSTOMER_SO_INTERCO,
		-- SO INTERCO TO DO CONS --
		CASE 
			WHEN DF.DELIVERY_CONS_CREATED_DATE IS NULL AND SOPROD.SALES_ORDER_INTERCO_CREATED_DATE IS NULL THEN 'N/A' 
			WHEN DF.DELIVERY_CONS_CREATED_DATE IS NOT NULL AND SOPROD.SALES_ORDER_INTERCO_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, SOPROD.SALES_ORDER_INTERCO_CREATED_DATE, DF.DELIVERY_CONS_CREATED_DATE))) 
			WHEN DF.DELIVERY_CONS_CREATED_DATE IS NULL AND SOPROD.SALES_ORDER_INTERCO_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, SOPROD.SALES_ORDER_INTERCO_CREATED_DATE, CURRENT_DATE))) 
			ELSE 'N/A' 
		END AS SELISIH_SO_INTERCO_DO_CONS,
		CASE
		    WHEN SELISIH_SO_INTERCO_DO_CONS = 'N/A' THEN 'N/A'
		    WHEN SELISIH_SO_INTERCO_DO_CONS = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_SO_INTERCO_DO_CONS = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_SO_INTERCO_DO_CONS = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_SO_INTERCO_DO_CONS = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_SO_INTERCO_DO_CONS BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_SO_INTERCO_DO_CONS BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_SO_INTERCO_DO_CONS BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_SO_INTERCO_DO_CONS > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_SO_INTERCO_DO_CONS,
		-- GI CONS TO POD --
		CASE
			WHEN DOPROD.DELIVERY_INTERCO_CREATED_DATE IS NULL AND DF.GI_CONS_CREATED_DATE IS NULL THEN 'N/A' 
			WHEN DOPROD.DELIVERY_INTERCO_CREATED_DATE IS NOT NULL AND DF.GI_CONS_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, TRY_TO_DATE(DF.GI_CONS_CREATED_DATE), TRY_TO_DATE(DOPROD.DELIVERY_INTERCO_CREATED_DATE)))) 
			WHEN DOPROD.DELIVERY_INTERCO_CREATED_DATE IS NULL AND DF.GI_CONS_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, TRY_TO_DATE(DF.GI_CONS_CREATED_DATE), CURRENT_DATE))) 
			ELSE 'N/A' 
		END AS SELISIH_GI_CONS_POD_INTERCO,
		CASE
		    WHEN SELISIH_GI_CONS_POD_INTERCO = 'N/A' THEN 'N/A'
		    WHEN SELISIH_GI_CONS_POD_INTERCO = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_GI_CONS_POD_INTERCO = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_GI_CONS_POD_INTERCO = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_GI_CONS_POD_INTERCO = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_GI_CONS_POD_INTERCO BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_GI_CONS_POD_INTERCO BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_GI_CONS_POD_INTERCO BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_GI_CONS_POD_INTERCO > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_GI_CONS_POD_INTERCO,
		-- POD TO BILLING INTERCO --
		CASE
			WHEN BLPROD.BILLING_INTERCO_CREATED_DATE IS NULL AND DOPROD.DELIVERY_INTERCO_CREATED_DATE IS NULL THEN 'N/A' 
			WHEN BLPROD.BILLING_INTERCO_CREATED_DATE IS NOT NULL AND DOPROD.DELIVERY_INTERCO_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, DOPROD.DELIVERY_INTERCO_CREATED_DATE, BLPROD.BILLING_INTERCO_CREATED_DATE))) 
			WHEN BLPROD.BILLING_INTERCO_CREATED_DATE IS NULL AND DOPROD.DELIVERY_INTERCO_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, DOPROD.DELIVERY_INTERCO_CREATED_DATE, CURRENT_DATE))) 
			ELSE 'N/A' 
		END AS SELISIH_POD_INTERCO_BILLING_INTERCO,
		CASE
		    WHEN SELISIH_POD_INTERCO_BILLING_INTERCO = 'N/A' THEN 'N/A'
		    WHEN SELISIH_POD_INTERCO_BILLING_INTERCO = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_POD_INTERCO_BILLING_INTERCO = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_POD_INTERCO_BILLING_INTERCO = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_POD_INTERCO_BILLING_INTERCO = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_POD_INTERCO_BILLING_INTERCO BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_POD_INTERCO_BILLING_INTERCO BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_POD_INTERCO_BILLING_INTERCO BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_POD_INTERCO_BILLING_INTERCO > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_POD_INTERCO_BILLING_INTERCO,
		-- BILLING INTERCO TO BILLING CUSTOMER --
		CASE 
			WHEN BL.BILLING_CREATED_DATE IS NULL AND BLPROD.BILLING_INTERCO_CREATED_DATE IS NULL THEN 'N/A' 
			WHEN BL.BILLING_CREATED_DATE IS NOT NULL AND BLPROD.BILLING_INTERCO_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, BLPROD.BILLING_INTERCO_CREATED_DATE, BL.BILLING_CREATED_DATE))) 
			WHEN BL.BILLING_CREATED_DATE IS NULL AND BLPROD.BILLING_INTERCO_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, BLPROD.BILLING_INTERCO_CREATED_DATE, CURRENT_DATE))) 
			ELSE 'N/A' 
		END AS SELISIH_BILLING_INTERCO_BILLING_CUSTOMER,
		CASE
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CUSTOMER = 'N/A' THEN 'N/A'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CUSTOMER = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CUSTOMER = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CUSTOMER = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CUSTOMER = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CUSTOMER BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CUSTOMER BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CUSTOMER BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_BILLING_INTERCO_BILLING_CUSTOMER > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_BILLING_INTERCO_BILLING_CUSTOMER,
		-- BILLING CUSTOMER TO TF/TG --
		CASE 
			WHEN TF.TF_CUSTOMER_CREATED_DATE IS NULL AND BL.BILLING_CREATED_DATE IS NULL THEN 'N/A' 
			WHEN TF.TF_CUSTOMER_CREATED_DATE IS NOT NULL AND BL.BILLING_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, BL.BILLING_CREATED_DATE, TF.TF_CUSTOMER_CREATED_DATE))) 
			WHEN TF.TF_CUSTOMER_CREATED_DATE IS NULL AND BL.BILLING_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, BL.BILLING_CREATED_DATE, CURRENT_DATE))) ELSE 'N/A' END AS SELISIH_BILLING_CUSTOMER_TF_CUSTOMER,
		CASE
		    WHEN SELISIH_BILLING_CUSTOMER_TF_CUSTOMER = 'N/A' THEN 'N/A'
		    WHEN SELISIH_BILLING_CUSTOMER_TF_CUSTOMER = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_BILLING_CUSTOMER_TF_CUSTOMER = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_TF_CUSTOMER = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_TF_CUSTOMER = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_TF_CUSTOMER BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_TF_CUSTOMER BETWEEN 8 AND 10 THEN '6/ 7-10 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_TF_CUSTOMER BETWEEN 11 AND 14 THEN '7/ 11-14 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_TF_CUSTOMER BETWEEN 15 AND 30 THEN '8/ 14-30 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_TF_CUSTOMER > 30 THEN '9/ >30 Hari'
		    ELSE ''
		END AS AGING_BILLING_CUSTOMER_TF_CUSTOMER,
		-- BILLING INTERCO TO TF INTERCO --
		CASE 
			WHEN TFPROD.TF_INTERCO_CREATED_DATE IS NULL AND BLPROD.BILLING_INTERCO_CREATED_DATE IS NULL THEN 'N/A' 
			WHEN TFPROD.TF_INTERCO_CREATED_DATE IS NOT NULL AND BLPROD.BILLING_INTERCO_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, BLPROD.BILLING_INTERCO_CREATED_DATE, TFPROD.TF_INTERCO_CREATED_DATE))) 
			WHEN TFPROD.TF_INTERCO_CREATED_DATE IS NULL AND BLPROD.BILLING_INTERCO_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, BLPROD.BILLING_INTERCO_CREATED_DATE, CURRENT_DATE))) 
			ELSE 'N/A' 
		END AS SELISIH_BILLING_INTERCO_TF_INTERCO,
		CASE
		    WHEN SELISIH_BILLING_INTERCO_TF_INTERCO = 'N/A' THEN 'N/A'
		    WHEN SELISIH_BILLING_INTERCO_TF_INTERCO = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_BILLING_INTERCO_TF_INTERCO = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_BILLING_INTERCO_TF_INTERCO = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_BILLING_INTERCO_TF_INTERCO = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_BILLING_INTERCO_TF_INTERCO BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_BILLING_INTERCO_TF_INTERCO BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_BILLING_INTERCO_TF_INTERCO BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_BILLING_INTERCO_TF_INTERCO > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_BILLING_INTERCO_TF_INTERCO,
			-- TF/TG TO BILLING CLEARING CUSTOMER --
		CASE 
			WHEN BC.BILLING_CLEAR_CREATED_DATE IS NULL AND TF.TF_CUSTOMER_CREATED_DATE IS NULL THEN 'N/A' 
			WHEN BC.BILLING_CLEAR_CREATED_DATE IS NOT NULL AND TF.TF_CUSTOMER_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, TF.TF_CUSTOMER_CREATED_DATE, BC.BILLING_CLEAR_CREATED_DATE))) 
			WHEN BC.BILLING_CLEAR_CREATED_DATE IS NULL AND TF.TF_CUSTOMER_CREATED_DATE IS NOT NULL THEN TO_VARCHAR(ABS(DATEDIFF(DAY, TF.TF_CUSTOMER_CREATED_DATE, CURRENT_DATE))) 
			ELSE 'N/A' 
		END AS SELISIH_TF_CUSTOMER_BILLING_CLEARING_CUSTOMER,
		CASE
		    WHEN SELISIH_TF_CUSTOMER_BILLING_CLEARING_CUSTOMER = 'N/A' THEN 'N/A'
		    WHEN SELISIH_TF_CUSTOMER_BILLING_CLEARING_CUSTOMER = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_TF_CUSTOMER_BILLING_CLEARING_CUSTOMER = 1 THEN '2/ 1 Hari'
