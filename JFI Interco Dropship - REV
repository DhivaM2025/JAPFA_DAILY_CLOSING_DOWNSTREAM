		    WHEN SELISIH_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER = 0 THEN '1/ Hari - H'
		    WHEN SELISIH_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER = 1 THEN '2/ 1 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER = 2 THEN '3/ 2 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER = 3 THEN '4/ 3 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
		    WHEN SELISIH_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER > 30 THEN '8/ >30 Hari'
		    ELSE ''
		END AS AGING_BILLING_CUSTOMER_BILLING_CLEARING_CUSTOMER,
	-- BILLING CUSTOMER TO BILLING CLEARING --
		CASE 
			WHEN BC.BILLING_CLEAR_CREATED_DATE IS NULL AND BLPROD.BILLING_DUE_DATE_INTERCO IS NULL THEN 'N/A' 
