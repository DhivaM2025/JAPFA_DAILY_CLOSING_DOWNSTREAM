WITH so_qty AS (
    SELECT 
        f.SOURCE_SYSTEM,
        f.SALES_ORDER_NUMBER,
        f.SALES_OFFICE,
        S.SALES_OFFICE_DESC ,
        f.BASE_UOM,
        SUM(f.SALES_ORDER_QUANTITY_IN_BASE_UOM) AS SALES_ORDER_QTY_BASE,
        SUM(f.SALES_ORDER_QUANTITY_IN_KG)        AS SALES_ORDER_QTY_KG
    FROM F_SALES_SALES_ORDER f
    LEFT JOIN D_SALES_CUSTOMER s 
     ON f.SOURCE_SYSTEM = s.SOURCE_SYSTEM 
     AND  f.CUSTOMER = s.CUSTOMER 
     AND  f.Sales_Organization = s.Sales_Organization 
     AND  f.Distribution_Channel = s.Distribution_Channel 
     and f.Division = s.Sales_Division
    GROUP BY
        f.SOURCE_SYSTEM,
        f.SALES_ORDER_NUMBER,
        f.SALES_OFFICE,
        f.BASE_UOM,
        s.SALES_OFFICE_DESC
), sel AS (
 SELECT DISTINCT
  f.FLAG ,
  f.SOURCE_SYSTEM ,
  f.SALES_ORDER_NUMBER
 FROM F_SALES_INTERCO_HEADER f
 WHERE f.SALES_ORDER_EXTERNAL_DOCUMENT IS NULL
), pro AS (
 SELECT DISTINCT 
  f.FLAG,
  f.SOURCE_SYSTEM,
  f.SALES_ORDER_NUMBER,
  f.SALES_ORDER_EXTERNAL_DOCUMENT 
 FROM F_SALES_INTERCO_HEADER f
 WHERE f.SALES_ORDER_EXTERNAL_DOCUMENT IS NOT NULL
), final_q AS (
    SELECT
        /* SELLING ENTITY */
        sel.SOURCE_SYSTEM              AS SEL_SOURCE_SYSTEM,
        sel.SALES_ORDER_NUMBER         AS SEL_SALES_ORDER,
        qs.SALES_OFFICE       AS SEL_SALES_OFFICE,
        qs.SALES_OFFICE_DESC     AS SEL_SALES_OFFICE_DESC,
        qs.SALES_ORDER_QTY_BASE        AS SEL_QTY_BASE,
        qs.SALES_ORDER_QTY_KG          AS SEL_QTY_KG,

        /* PRODUCTION ENTITY */
        pro.SOURCE_SYSTEM              AS PRO_SOURCE_SYSTEM,
        pro.SALES_ORDER_NUMBER         AS PRO_SALES_ORDER,
        qp.SALES_OFFICE       AS PRO_SALES_OFFICE,
        qp.SALES_OFFICE_DESC     AS PRO_SALES_OFFICE_DESC,
        qp.SALES_ORDER_QTY_BASE        AS PRO_QTY_BASE,
        qp.SALES_ORDER_QTY_KG          AS PRO_QTY_KG,
        CASE
        WHEN sel.SALES_ORDER_NUMBER IS NOT NULL
         AND pro.SALES_ORDER_EXTERNAL_DOCUMENT IS NOT NULL
            THEN 'MATCH'
        WHEN sel.SALES_ORDER_NUMBER IS NOT NULL
         AND pro.SALES_ORDER_EXTERNAL_DOCUMENT IS NULL
            THEN 'SEL_ONLY'
        WHEN sel.SALES_ORDER_NUMBER IS NULL
         AND pro.SALES_ORDER_EXTERNAL_DOCUMENT IS NOT NULL
            THEN 'PRO_ONLY'
     END AS SO_MATCH_STATUS
    FROM sel
    FULL OUTER JOIN pro
        ON pro.SALES_ORDER_EXTERNAL_DOCUMENT = sel.SALES_ORDER_NUMBER

    /* qty selling */
    LEFT JOIN so_qty qs
        ON qs.SALES_ORDER_NUMBER = sel.SALES_ORDER_NUMBER
       AND qs.SOURCE_SYSTEM     = sel.SOURCE_SYSTEM

    /* qty production */
    LEFT JOIN so_qty qp
        ON qp.SALES_ORDER_NUMBER = pro.SALES_ORDER_NUMBER
       AND qp.SOURCE_SYSTEM     = pro.SOURCE_SYSTEM
)
SELECT
    * 
    ,
    CASE
        WHEN SEL_QTY_KG IS NULL OR PRO_QTY_KG IS NULL
            THEN 'MISSING'
        WHEN ABS(SEL_QTY_KG - PRO_QTY_KG) = 0
            THEN 'MATCH'
        ELSE 'NOT_MATCH'
    END AS QTY_COMPARE_STATUS 
    FROM FINAL_Q
    
    ;
