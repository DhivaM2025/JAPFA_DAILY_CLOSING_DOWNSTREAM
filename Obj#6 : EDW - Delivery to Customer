WITH ALL_DELIVERY AS (
SELECT 
    f.source_system,
    f.COMPANY_CODE ||'-'|| dcom.COMPANY_NAME AS COMPANY,
    f.plant ||'-'|| dscap.PLANT_NAME AS PLANT,
	CASE
	    WHEN f.PLANT IN ('8501','8502','8503','8504','8505','8506','8507','8508','8509','8510','8511','8512','8513','8514','8515','8516','8517','8518','8519','8520','8521','8522','8523','8524','8525') THEN 'B2B PP'
	    WHEN f.PLANT = '8700' THEN 'B2B VAM'
	    WHEN f.PLANT IN ('90CA','90CB','90CC','90CD','90CE','90CF','90CG','90CH','90CI','90CJ','90CK','90CL','90CM','90CN') THEN 'B2B - BDG'
	    WHEN f.PLANT = '90HA' THEN 'B2C - JKF'
	    WHEN f.PLANT IN ('90BA','90BB') THEN 'B2C - JKMO'
	    WHEN f.PLANT IN ('90AA','90AB','90AC','90AD','90AE','90AF','90AG','90AH','90AI','90AJ','90AK','90AL','90AM','90AN','90BC','90BD','90BE','90BF') THEN 'B2C - JKTO'
	    WHEN f.PLANT IN ('90FA','90FB','90FC','90FD','90FE','90FF','90FG','90FH','90FI','90FJ','90FK','90JA','90LA','90NA','90OA','90QA') THEN 'B2C - LJB'
	    WHEN f.PLANT IN ('90IA','90IB','90IC','90ID','90IE','90MA') THEN 'B2C - LJM'
	    WHEN f.PLANT IN ('90GA','90GB','90GC','90GD','90GE','90GF','90GG','90GH','90GI','90GJ','90KA') THEN 'B2C - LJT'
	    WHEN f.PLANT IN ('90EA','90EB','90EC','90ED','90EE','90EF','90EG','90EH','90EI','90EJ','90EK','90EL','90EM','90EN','90EO','90EP','90EQ','90PA') THEN 'B2C - SBY'
	    WHEN f.PLANT = '906A' THEN 'B2C - SCM'
	    WHEN f.PLANT IN ('90DA','90DB','90DC','90DD','90DE','90DF','90DG','90DH','90DI','90DJ','90DK','90DL','90DM','90DN','90DO') THEN 'B2C - SMG'
	    WHEN f.PLANT = '8500' THEN 'JFI - B2B HO'
	    WHEN f.PLANT = '8400' THEN 'JFI - EXPORT HO'
	    WHEN f.PLANT = '9000' THEN 'JFI - HO'
	    WHEN f.PLANT IN ('901A','902A','903A','904A','905A','905B','905C','905D','90VA','90VB','90VC','90WA','90XA','90YA','90ZA') THEN 'JFI - MFG'
	    ELSE NULL
	END AS PLANT_GROUP,
	f.CUSTOMER,
    f.DISTRIBUTION_CHANNEL ||'-'|| dsa.DISTRIBUTION_CHANNEL_DESC AS DISTRIBUTION_CHANNEL,
	CUST.REGION || '-' || DSR.REGION_DESCRIPTION AS REGION,
	CASE 
		WHEN CUST.REGION IN ('01', '02', '03', '04', '05', '28') THEN 'PULAU JAWA'
    	ELSE 'LUAR JAWA'
	END AS REGION_GROUP,
	CASE 
    	WHEN SO.SALES_ORDER_TYPE = 'ZB20' AND SO.PLANT = '90HA' THEN 'Interco Automation MT'
        WHEN SO.SALES_ORDER_TYPE = 'ZKS9' AND SO.PLANT LIKE '85%' THEN 'Interco Automation B2B'
        WHEN SO.SALES_ORDER_TYPE = 'ZKSE' AND SO.PLANT LIKE '87%' THEN 'Interco Automation B2B VAM'
        ELSE 'Non Interco'
	END AS CATEGORY,
	    SO.SALES_ORDER_TYPE ||'-'|| SO.SALES_ORDER_TYPE_DESC AS SALES_ORDER_TYPE,
    f.delivery_type ||'-'|| f.DELIVERY_TYPE_DESC AS DELIVERY_TYPE,
    SO.SALES_ORDER_STATUS_REJECTION ||'-'|| SO.SALES_ORDER_STATUS_REJECTION_DESC AS SALES_ORDER_STATUS_REJECTION,
	CASE 
  		WHEN f.DELIVERY_STATUS = 'Not yet processed' THEN 'A-Not yet processed'
    	WHEN f.DELIVERY_STATUS = 'Partially processed' THEN 'B-Partially processed'
    	WHEN f.DELIVERY_STATUS = 'Completely processed' THEN 'C-Completely processed'
    	ELSE f.DELIVERY_STATUS
	END AS DELIVERY_STATUS,
	CASE 
		WHEN f.DELIVERY_POD_STATUS = 'Not yet processed' THEN 'A-Not yet processed'
	    WHEN f.DELIVERY_POD_STATUS = 'Partially processed' THEN 'B-Partially processed'
	    WHEN f.DELIVERY_POD_STATUS = 'Completely processed' THEN 'C-Completely processed'
	    ELSE f.DELIVERY_POD_STATUS
	END AS POD_STATUS,
    f.REFERENCE_SALES_ORDER_NUMBER AS SALES_ORDER_NUMBER,
    f.delivery_number,
    GI_NUMBER,
    TO_DATE(SO.SALES_ORDER_CREATED_DATE, 'YYYYMMDD') AS SALES_ORDER_CREATED_DATE,
	CASE 
        WHEN f.DELIVERY_CREATED_DATE = '00000000' OR f.DELIVERY_CREATED_DATE IS NULL THEN NULL
        ELSE TO_DATE(f.DELIVERY_CREATED_DATE, 'YYYYMMDD')
    END AS DELIVERY_CREATED_DATE,
	CASE 
        WHEN f.DELIVERY_ACTUAL_DATE = '00000000' OR f.DELIVERY_ACTUAL_DATE IS NULL THEN NULL
        ELSE TO_DATE(f.DELIVERY_ACTUAL_DATE, 'YYYYMMDD')
    END AS ACTUAL_DELIVERY_DATE,
    TO_DATE(gi.ENTRY_DATE, 'YYYYMMDD') AS GI_ENTRY_DATE,
	CASE 
        WHEN f.DELIVERY_POSTING_DATE = '00000000' OR f.DELIVERY_POSTING_DATE IS NULL THEN NULL
        ELSE TO_DATE(f.DELIVERY_POSTING_DATE, 'YYYYMMDD')
    END AS POD_DATE,
    SO.SALES_ORDER_QUANTITY_IN_KG AS SALES_ORDER_QTY_IN_KG,
    SO.SALES_ORDER_QUANTITY_IN_BASE_UOM AS SALES_ORDER_QTY_IN_BASE_UOM,
    SO.SALES_ORDER_TOTAL_AMOUNT,
    f.base_uom,
    -- Total Delivery Qty --
    SUM(CASE 
            WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') 
            THEN f.delivery_quantity_in_kg 
            ELSE 0 
        END) AS TOTAL_DELIVERY_QTY_IN_KG,
	SUM(CASE 
    	WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') 
        THEN f.DELIVERY_QUANTITY_IN_BASE_UOM
        ELSE 0 
	END) AS total_delivery_qty_in_base_uom,
    SUM(CASE 
        WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') 
        THEN f.DELIVERY_QUANTITY_IN_BASE_UOM * delivery_price.PRICE
        ELSE 0 
    END) AS total_delivery_amount,
    -- Completed_Delivery_QTY --
    SUM(CASE 
            WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND f.DELIVERY_STATUS = 'Completely processed' AND f.DELIVERY_NOTE IS NULL
            THEN f.delivery_quantity_in_kg 
            ELSE 0 
	END) AS COMPLETED_DELIVERY_QTY_IN_KG,      
    SUM(CASE 
            WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND f.DELIVERY_STATUS = 'Completely processed' AND f.DELIVERY_NOTE IS NULL
            THEN f.DELIVERY_QUANTITY_IN_BASE_UOM
            ELSE 0 
    END) AS completed_delivery_qty_in_base_uom,
    SUM(CASE 
            WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND f.DELIVERY_STATUS = 'Completely processed' AND f.DELIVERY_NOTE IS NULL
            THEN f.DELIVERY_QUANTITY_IN_BASE_UOM * delivery_price.PRICE
            ELSE 0 
    END) AS completed_delivery_amount,
    -- Not yet delivery QTY
    SUM(CASE 
            WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND f.DELIVERY_STATUS <> 'Completely processed' AND f.DELIVERY_NOTE IS NULL
            THEN f.delivery_quantity_in_kg 
            ELSE 0 
    END) AS not_yet_delivery_qty_in_kg,
    SUM(CASE 
            WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND f.DELIVERY_STATUS <> 'Completely processed' AND f.DELIVERY_NOTE IS NULL
            THEN f.DELIVERY_QUANTITY_IN_BASE_UOM
            ELSE 0 
    END) AS not_yet_delivery_qty_in_base_uom,
    SUM(CASE 
            WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND f.DELIVERY_STATUS <> 'Completely processed' AND f.DELIVERY_NOTE IS NULL
            THEN f.DELIVERY_QUANTITY_IN_BASE_UOM * delivery_price.PRICE
            ELSE 0 
    END) AS not_yet_delivery_amount,
	-- Delivery Rejection
	SUM (CASE 
			WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND f.DELIVERY_NOTE IS NOT NULL
			THEN f.delivery_quantity_in_kg 
            ELSE 0 
    END) AS delivery_rejection_qty_in_kg,
	SUM (CASE 
			WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND f.DELIVERY_NOTE IS NOT NULL
			THEN f.DELIVERY_QUANTITY_IN_BASE_UOM
            ELSE 0 
    END) AS delivery_rejection_qty_in_base_uom,
	SUM (CASE 
			WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND f.DELIVERY_NOTE IS NOT NULL
			THEN f.DELIVERY_QUANTITY_IN_BASE_UOM * delivery_price.PRICE
            ELSE 0 
    END) AS delivery_rejection_amount,
    -- Return QTY    
    SUM(CASE 
            WHEN f.delivery_type IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') 
            THEN f.delivery_quantity_in_kg 
            ELSE 0 
    END) AS return_qty_in_kg,     
    SUM(CASE 
            WHEN f.delivery_type IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') 
            THEN f.DELIVERY_QUANTITY_IN_BASE_UOM
            ELSE 0 
    END) AS return_qty_in_base_uom,  
    SUM(CASE 
            WHEN f.delivery_type IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') 
            THEN f.DELIVERY_QUANTITY_IN_BASE_UOM * delivery_price.PRICE
            ELSE 0 
    END) AS return_amount,         
    -- Susut
    SUM(CASE 
    		WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND pod.POD_REASON = 'DFG2'
            THEN pod.DIFF_POD_QUANTITY_IN_KG
            ELSE 0 
	END) AS susut_delivery_qty_in_kg,
    SUM(CASE 
    		WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND pod.POD_REASON = 'DFG2'
            THEN pod.DIFF_POD_QUANTITY_IN_BASE_UOM  
            ELSE 0 
	END) AS susut_delivery_qty_in_base_uom,
    SUM(CASE 
    		WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND pod.POD_REASON = 'DFG2'
            THEN pod.DIFF_POD_QUANTITY_IN_BASE_UOM  * delivery_price.PRICE   
            ELSE 0 
	END) AS susut_delivery_amount,	  
    -- Timbul
    SUM(CASE 
        	WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND pod.POD_REASON = 'DFG1'
            THEN pod.DIFF_POD_QUANTITY_IN_KG 
            ELSE 0 
	END) AS timbul_delivery_qty_in_kg,
    SUM(CASE 
        	WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND pod.POD_REASON = 'DFG1'
            THEN pod.DIFF_POD_QUANTITY_IN_BASE_UOM
            ELSE 0 
	END) AS timbul_delivery_qty_in_base_uom,
    SUM(CASE 
        	WHEN f.delivery_type NOT IN ('NCR','ZB51','ZB54','ZB55','ZKR1','ZKR2','ZKR3','ZKR5','ZKRA','ZKRC') AND pod.POD_REASON = 'DFG1'
            THEN pod.DIFF_POD_QUANTITY_IN_BASE_UOM * delivery_price.PRICE
            ELSE 0 
	END) AS timbul_delivery_amount,  
	f.DELIVERY_NOTE AS REASON_POD,
	CASE 
	    WHEN f.DELIVERY_NOTE = 'FREEZER RUSAK' THEN 'Customer Related'
	    WHEN f.DELIVERY_NOTE = 'OUTLET TDK BISA INPUT SKU' THEN 'Customer Related'
	    WHEN f.DELIVERY_NOTE = 'OVER STOCK' THEN 'Customer Related' 
	    WHEN f.DELIVERY_NOTE = 'STOCK FISIK ≠ SISTEM' THEN 'Customer Related'
	    WHEN f.DELIVERY_NOTE = 'TOKO TIDAK ORDER' THEN 'Order Related'
	    WHEN f.DELIVERY_NOTE = 'TOKO TIDAK PUNYA UANG' THEN 'Customer Related'
	    WHEN f.DELIVERY_NOTE = 'TOKO TUTUP' THEN 'Customer Related'
	    WHEN f.DELIVERY_NOTE = 'ALAMAT TIDAK SESUAI' THEN 'Delivery Related'
		WHEN f.DELIVERY_NOTE = 'BATAL KIRIM' THEN 'Delivery Related'
	    WHEN f.DELIVERY_NOTE = 'BARANG/KEMASAN RUSAK' THEN 'Delivery Related'
	    WHEN f.DELIVERY_NOTE = 'RETUR PRODUK TDK DIAMBIL' THEN 'Delivery Related'
	    WHEN f.DELIVERY_NOTE = 'RETUR SF CONSIGMENT' THEN 'Delivery Related'
	    WHEN f.DELIVERY_NOTE = 'SALAH LOADING' THEN 'Delivery Related'
	    WHEN f.DELIVERY_NOTE = 'SALAH KIRIM TOKO' THEN 'Delivery Related'
	    WHEN f.DELIVERY_NOTE = 'SPACE TIDAK CUKUP' THEN 'Customer Related'
	    WHEN f.DELIVERY_NOTE = 'SUHU MOBIL TIDAK SESUAI' THEN 'Delivery Related'
	    WHEN f.DELIVERY_NOTE = 'TIDAK TERKIRIM (TPL)' THEN 'Delivery Related'
	    WHEN f.DELIVERY_NOTE = 'WAKTU DELIVERY TDK CUKUP' THEN 'Delivery Related'
	    WHEN f.DELIVERY_NOTE = 'DOUBLE PO' THEN 'Order Related'
	    WHEN f.DELIVERY_NOTE = 'SALAH INPUT DI ANDROID' THEN 'Order Related'
	    WHEN f.DELIVERY_NOTE = 'SALAH INPUT SO/DO' THEN 'Order Related'
	    WHEN f.DELIVERY_NOTE = 'TIDAK SESUAI ORDER/PO' THEN 'Order Related'
	    WHEN f.DELIVERY_NOTE = 'BARANG SUSUT' THEN 'Stock Related'
	    WHEN f.DELIVERY_NOTE = 'ISI/PRODUK TIDAK SESUAI' THEN 'Stock Related'
	    WHEN f.DELIVERY_NOTE = 'PRODUK MENDEKATI EXPIRED' THEN 'Stock Related'
	    WHEN f.DELIVERY_NOTE = 'DO LEBIH DARI 3 HARI' THEN 'Delivery Related'
	    WHEN f.DELIVERY_NOTE = 'FORCE MAJEURE' THEN 'Delivery Related'
	    WHEN f.DELIVERY_NOTE IS NULL OR f.DELIVERY_NOTE = '' THEN 'N/A'
	    ELSE 'N/A'
	END AS REASON_POD_GROUP,
-- SELISIH TANGGAL PADA MASING-MASING PROSES
	CASE 
		WHEN TRY_TO_DATE(f.DELIVERY_CREATED_DATE, 'YYYYMMDD') IS NOT NULL AND TRY_TO_DATE(SO.SALES_ORDER_CREATED_DATE, 'YYYYMMDD') IS NOT NULL 
	    THEN TO_VARCHAR(DATEDIFF(DAY, TRY_TO_DATE(SO.SALES_ORDER_CREATED_DATE, 'YYYYMMDD'), TRY_TO_DATE(f.DELIVERY_CREATED_DATE, 'YYYYMMDD'))) 	
	    WHEN TRY_TO_DATE(f.DELIVERY_CREATED_DATE, 'YYYYMMDD') IS NULL AND TRY_TO_DATE(SO.SALES_ORDER_CREATED_DATE, 'YYYYMMDD') IS NOT NULL 
	    THEN TO_VARCHAR(DATEDIFF(DAY, TRY_TO_DATE(SO.SALES_ORDER_CREATED_DATE, 'YYYYMMDD'), CURRENT_DATE))									
	    ELSE 'N/A'
	END AS SELISIH_SO_DO,
	CASE 
	    WHEN TRY_TO_DATE(gi.ENTRY_DATE, 'YYYYMMDD') IS NOT NULL AND TRY_TO_DATE(f.DELIVERY_CREATED_DATE, 'YYYYMMDD') IS NOT NULL 
	    THEN TO_VARCHAR(DATEDIFF(DAY, TRY_TO_DATE(f.DELIVERY_CREATED_DATE, 'YYYYMMDD'), TRY_TO_DATE(gi.ENTRY_DATE, 'YYYYMMDD')))
		WHEN TRY_TO_DATE(gi.ENTRY_DATE, 'YYYYMMDD') IS NULL AND TRY_TO_DATE(f.DELIVERY_CREATED_DATE, 'YYYYMMDD') IS NOT NULL 
	    THEN TO_VARCHAR(DATEDIFF(DAY, TRY_TO_DATE(f.DELIVERY_CREATED_DATE, 'YYYYMMDD'), CURRENT_DATE))
	    ELSE 'N/A'
	END AS SELISIH_DO_GI,
	CASE 
	    WHEN TRY_TO_DATE(f.DELIVERY_POSTING_DATE, 'YYYYMMDD') IS NOT NULL AND TRY_TO_DATE(gi.ENTRY_DATE, 'YYYYMMDD') IS NOT NULL 
	    THEN TO_VARCHAR(DATEDIFF(DAY, TRY_TO_DATE(gi.ENTRY_DATE, 'YYYYMMDD'), TRY_TO_DATE(f.DELIVERY_POSTING_DATE, 'YYYYMMDD')))
		WHEN TRY_TO_DATE(f.DELIVERY_POSTING_DATE, 'YYYYMMDD') IS NULL AND TRY_TO_DATE(gi.ENTRY_DATE, 'YYYYMMDD') IS NOT NULL 
	    THEN TO_VARCHAR(DATEDIFF(DAY, TRY_TO_DATE(gi.ENTRY_DATE, 'YYYYMMDD'), CURRENT_DATE))
	    ELSE 'N/A'
	END AS SELISIH_GI_POD,
-- AGING ATAS SELISIH HARI PADA MASING-MASING PROSES
	CASE
	    WHEN SELISIH_SO_DO = 'N/A' THEN 'N/A'
	    WHEN SELISIH_SO_DO = 0 THEN '1/ Hari - H'
	    WHEN ABS(SELISIH_SO_DO) = 1 THEN '2/ 1 Hari'
	    WHEN ABS(SELISIH_SO_DO) = 2 THEN '3/ 2 Hari'
	    WHEN ABS(SELISIH_SO_DO) = 3 THEN '4/ 3 Hari'
	    WHEN ABS(SELISIH_SO_DO) BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
	    WHEN ABS(SELISIH_SO_DO) BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
	    WHEN ABS(SELISIH_SO_DO) BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
	    WHEN ABS(SELISIH_SO_DO) > 30 THEN '8/ >30 Hari'
    ELSE ''
	END AS AGING_SO_DO,
	CASE
	    WHEN SELISIH_DO_GI = 'N/A' THEN 'N/A'
	    WHEN SELISIH_DO_GI = 0 THEN '1/ Hari-H'
	    WHEN ABS(SELISIH_DO_GI) = 1 THEN '2/ 1 Hari'
	    WHEN ABS(SELISIH_DO_GI) = 2 THEN '3/ 2 Hari'
	    WHEN ABS(SELISIH_DO_GI) = 3 THEN '4/ 3 Hari'
	    WHEN ABS(SELISIH_DO_GI) BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
	    WHEN ABS(SELISIH_DO_GI) BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
	    WHEN ABS(SELISIH_DO_GI) BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
	    WHEN ABS(SELISIH_DO_GI) > 30 THEN '8/ >30 Hari'
    ELSE ''
	END AS AGING_DO_GI,
	CASE
	    WHEN SELISIH_GI_POD = 'N/A' THEN 'N/A'
	    WHEN SELISIH_GI_POD = 0 THEN '1/ Hari-H'
	    WHEN ABS(SELISIH_GI_POD) = 1 THEN '2/ 1 Hari'
	    WHEN ABS(SELISIH_GI_POD) = 2 THEN '3/ 2 Hari'
	    WHEN ABS(SELISIH_GI_POD) = 3 THEN '4/ 3 Hari'
	    WHEN ABS(SELISIH_GI_POD) BETWEEN 4 AND 7 THEN '5/ 4-7 Hari'
	    WHEN ABS(SELISIH_GI_POD) BETWEEN 8 AND 14 THEN '6/ 7-14 Hari'
	    WHEN ABS(SELISIH_GI_POD) BETWEEN 15 AND 30 THEN '7/ 14-30 Hari'
	    WHEN ABS(SELISIH_GI_POD) > 30 THEN '8/ >30 Hari'
    ELSE ''
	END AS AGING_GI_POD
FROM F_SALES_DELIVERY f
LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM,DISTRIBUTION_CHANNEL,SALES_ORDER_TYPE,SALES_ORDER_TYPE_DESC,SALES_ORDER_STATUS_REJECTION,PLANT,
			SALES_ORDER_STATUS_REJECTION_DESC,SALES_ORDER_CREATED_DATE,SALES_ORDER_NUMBER,SUM (SALES_ORDER_QUANTITY_IN_KG) AS SALES_ORDER_QUANTITY_IN_KG, SUM(SALES_ORDER_NET_AMOUNT) AS SALES_ORDER_TOTAL_AMOUNT,
			SUM (SALES_ORDER_QUANTITY_IN_BASE_UOM) AS SALES_ORDER_QUANTITY_IN_BASE_UOM FROM F_SALES_SALES_ORDER
			GROUP BY ALL) SO
	ON f.SOURCE_SYSTEM = so.SOURCE_SYSTEM 
	AND f.REFERENCE_SALES_ORDER_NUMBER = SO.SALES_ORDER_NUMBER
LEFT JOIN F_SALES_DELIVERY_POD pod
	ON pod.SOURCE_SYSTEM = f.SOURCE_SYSTEM AND pod.DELIVERY_NUMBER = f.DELIVERY_NUMBER AND pod.DELIVERY_ITEM = f.DELIVERY_ITEM
LEFT JOIN (
    SELECT
        SOURCE_SYSTEM,
        COMPANY_CODE,
        "REFERENCE" AS DELIVERY_NUMBER,
        MATERIAL_DOCUMENT_NUMBER AS GI_NUMBER,
        ENTRY_DATE
    FROM (
        SELECT
            SOURCE_SYSTEM,
            COMPANY_CODE,
            "REFERENCE",
            MATERIAL_DOCUMENT_NUMBER,
            ENTRY_DATE,
            ROW_NUMBER() OVER (
                PARTITION BY SOURCE_SYSTEM, COMPANY_CODE, "REFERENCE"
                ORDER BY MATERIAL_DOCUMENT_NUMBER ASC
            ) AS rn
        FROM F_SCM_STOCK_TRANSACTION_SAP
        WHERE MOVEMENT_TYPE = '601'
    )
    WHERE rn = 1
) gi
   ON gi.SOURCE_SYSTEM    = f.SOURCE_SYSTEM
   AND gi.COMPANY_CODE    = f.COMPANY_CODE
   AND gi.DELIVERY_NUMBER = f.DELIVERY_NUMBER
LEFT JOIN (SELECT DISTINCT PLANT, PLANT_NAME, COMPANY_CODE FROM D_SCM_COMPANY_AND_PLANT) dscap
    ON dscap.COMPANY_CODE = f.COMPANY_CODE 
    AND dscap.PLANT = f.PLANT
LEFT JOIN (
    SELECT 
        sd.source_system, 
        sd.DELIVERY_NUMBER,
        sd.DELIVERY_ITEM,
        sd.DELIVERY_QUANTITY_IN_BASE_UOM as delqty,
        sd.DELIVERY_TYPE ,
        so.SALES_ORDER_NET_AMOUNT,
        sum(ROUND(COALESCE(so.SALES_ORDER_NET_AMOUNT / NULLIF(sd.DELIVERY_QUANTITY_IN_BASE_UOM,0),0),2)) AS PRICE
    FROM F_SALES_DELIVERY sd
    LEFT JOIN F_SALES_SALES_ORDER so 
        ON sd.SOURCE_SYSTEM = so.SOURCE_SYSTEM 
        AND sd.REFERENCE_SALES_ORDER_NUMBER = so.SALES_ORDER_NUMBER 
        AND sd.REFERENCE_SALES_ORDER_ITEM = so.SALES_ORDER_ITEM
    GROUP BY ALL 
) delivery_price
    ON delivery_price.source_system = f.SOURCE_SYSTEM 
    AND delivery_price.DELIVERY_NUMBER = f.DELIVERY_NUMBER 
    AND delivery_price.DELIVERY_ITEM = f.DELIVERY_ITEM
LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM,COMPANY_CODE,COMPANY_NAME FROM D_SCM_COMPANY ) dcom
    ON dcom.SOURCE_SYSTEM = f.SOURCE_SYSTEM
    AND dcom.COMPANY_CODE = f.COMPANY_CODE     
LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM,DISTRIBUTION_CHANNEL,DISTRIBUTION_CHANNEL_DESC FROM D_SALES_AREA) dsa
	ON dsa.SOURCE_SYSTEM = f.SOURCE_SYSTEM
	AND dsa.DISTRIBUTION_CHANNEL = f.DISTRIBUTION_CHANNEL
LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM, CUSTOMER, CUSTOMER_NAME, REGION,COUNTRY FROM PROD_DB.DSTR_BI_COMMUNITY.D_SALES_CUSTOMER) CUST
    ON CUST.SOURCE_SYSTEM = f.SOURCE_SYSTEM
    AND CUST.CUSTOMER = f.CUSTOMER
LEFT JOIN (SELECT DISTINCT SOURCE_SYSTEM, REGION, REGION_DESCRIPTION,COUNTRY FROM PROD_DB.DSTR_BI_COMMUNITY.D_SALES_REGION) DSR
    ON DSR.SOURCE_SYSTEM = CUST.SOURCE_SYSTEM
    AND DSR.REGION = CUST.REGION
    AND DSR.COUNTRY = CUST.COUNTRY
GROUP BY f.source_system, f.company_code, actual_delivery_date, f.PLANT, dscap.PLANT_NAME, f.DELIVERY_NUMBER, f.base_uom, f.DELIVERY_TYPE, f.DELIVERY_TYPE_DESC, dcom.COMPANY_NAME, F.CUSTOMER,
		 F.DISTRIBUTION_CHANNEL, DSA.DISTRIBUTION_CHANNEL_DESC, CUST.REGION, DSR.REGION_DESCRIPTION, SO.SALES_ORDER_TYPE, SO.PLANT, SO.SALES_ORDER_TYPE_DESC, SO.SALES_ORDER_STATUS_REJECTION,
		 SO.SALES_ORDER_STATUS_REJECTION_DESC, F.DELIVERY_STATUS, F.DELIVERY_POD_STATUS, F.REFERENCE_SALES_ORDER_NUMBER,  GI_NUMBER, SO.SALES_ORDER_CREATED_DATE, F.DELIVERY_CREATED_DATE,
		 GI.ENTRY_DATE, F.DELIVERY_POSTING_DATE, SO.SALES_ORDER_QUANTITY_IN_KG, F.DELIVERY_NOTE, SO.SALES_ORDER_QUANTITY_IN_BASE_UOM, SO.SALES_ORDER_TOTAL_AMOUNT
ORDER BY f.SOURCE_SYSTEM DESC, actual_delivery_date DESC 
) SELECT  
	SOURCE_SYSTEM,
	COMPANY, 
	PLANT,
	PLANT_GROUP,
	CUSTOMER,
    DISTRIBUTION_CHANNEL,
	REGION,
	REGION_GROUP,
	CATEGORY,
	SALES_ORDER_TYPE,
	DELIVERY_TYPE,
	SALES_ORDER_STATUS_REJECTION,
	DELIVERY_STATUS,
	POD_STATUS,
	SALES_ORDER_NUMBER,
	DELIVERY_NUMBER, 
	GI_NUMBER,
	SALES_ORDER_CREATED_DATE,
	DELIVERY_CREATED_DATE,
	ACTUAL_DELIVERY_DATE,
	GI_ENTRY_DATE,
	POD_DATE,
	BASE_UOM,
	SALES_ORDER_QTY_IN_KG,
	SALES_ORDER_QTY_IN_BASE_UOM,
	ROUND(COALESCE(TOTAL_DELIVERY_AMOUNT/NULLIF(TOTAL_DELIVERY_QTY_IN_BASE_UOM,0),0),2) AS SALES_ORDER_PRICE,
	SALES_ORDER_TOTAL_AMOUNT,
	TOTAL_DELIVERY_QTY_IN_KG, 
	TOTAL_DELIVERY_QTY_IN_BASE_UOM,
	TOTAL_DELIVERY_AMOUNT,
	COMPLETED_DELIVERY_QTY_IN_KG,
	COMPLETED_DELIVERY_QTY_IN_BASE_UOM,
	COMPLETED_DELIVERY_AMOUNT,
	NOT_YET_DELIVERY_QTY_IN_KG,
	NOT_YET_DELIVERY_QTY_IN_BASE_UOM,
	NOT_YET_DELIVERY_AMOUNT,
	delivery_rejection_qty_in_kg,
	delivery_rejection_qty_in_base_uom,
	delivery_rejection_amount,
	RETURN_QTY_IN_KG,
	RETURN_QTY_IN_BASE_UOM,
	RETURN_AMOUNT,
	SUSUT_DELIVERY_QTY_IN_KG,
	SUSUT_DELIVERY_QTY_IN_BASE_UOM,
	SUSUT_DELIVERY_AMOUNT,
	TIMBUL_DELIVERY_QTY_IN_KG,
	TIMBUL_DELIVERY_QTY_IN_BASE_UOM,
	TIMBUL_DELIVERY_AMOUNT,
	REASON_POD,
	REASON_POD_GROUP,
	SELISIH_SO_DO,
	SELISIH_DO_GI,
	SELISIH_GI_POD,
	AGING_SO_DO,
	AGING_DO_GI,
	AGING_GI_POD
FROM ALL_DELIVERY
WHERE ACTUAL_DELIVERY_DATE BETWEEN '2026-03-01' AND '2026-03-31' AND SOURCE_SYSTEM = 'PE1' AND COMPANY LIKE '%ID90%' /*AND SALES_ORDER_NUMBER IN ('1208063351','2194936073','1800197655','1208032436','1800197136')*/
;
