SELECT
    CASE 
        WHEN AR.SALES_OFFICE_DESC IS NOT NULL AND AR.SALES_OFFICE_DESC <> '' 
            THEN REGEXP_SUBSTR(AR.SALES_OFFICE_DESC, '[^ ]+$')
        WHEN AR.SALES_OFFICE IS NOT NULL AND AR.SALES_OFFICE <> '' 
            THEN AR.SALES_OFFICE
        ELSE NULL
    END AS SALES_OFFICE_LOKASI,
    CASE
        WHEN AR.PROFIT_CENTER_NAME IS NOT NULL AND AR.PROFIT_CENTER_NAME <> ''
            THEN REGEXP_SUBSTR(AR.PROFIT_CENTER_NAME, '[^ ]+$')
        WHEN AR.PROFIT_CENTER IS NOT NULL AND AR.PROFIT_CENTER <> ''
            THEN AR.PROFIT_CENTER
        ELSE NULL
    END AS PROFIT_CENTER_LOKASI,
    AR.BILLING_NUMBER,
    AR.REFERENCE_DOCUMENT,
    AR.ACCOUNT_DOC_NUMBER,
    AR.DOCUMENT_TYPE || ' - ' || AR.DOCUMENT_TYPE_DESC AS DOCUMENT_TYPE,
    AR.CUSTOMER_GROUP || ' - ' || AR.CUSTOMER_GROUP_DESC AS CUSTOMER_GROUP,
    AR.SALES_DIVISION || ' - ' || AR.SALES_DIVISION_DESC AS SALES_DIVISION,
    AR.CUSTOMER,
    AR.CUSTOMER_NAME,
    AR.CREDIT_OWNER,
    AR.CREDIT_OWNER_NAME,
    AR.BUSINESS_NAME_CODE,
    AR.BUSINESS_NAME,
    AR.TAX_CUSTOMER_ID,
    AR.TAX_CUSTOMER_NAME,
    AR.DUE_DATE,
    COALESCE(BILL.BILLING_DATE, AD.POSTING_DATE) AS BILLING_DATE,
    AR.EFFECTIVE_BASELINE_DATE AS BASELINE_DATE,
    /*AD.POSTING_DATE,*/
    AR.TOTAL_AMOUNT,
    AR.REMARKS_DOC_TYPE,
    AR.NOT_DUE,
    AR.DAYS_1_10,
    AR.DAYS_11_30,
    AR.DAYS_31_60,
    AR.DAYS_61_90,
    AR.DAYS_91_120,
    AR.DAYS_121_150,
    AR.DAYS_151_360,
    AR.OVER_361_DAYS,
    -- TF.TTF_DOC_DATE,
    AR.EFFECTIVE_BASELINE_DATE_FLAG,
    AR.PAYMENT_TERM_DAYS,
    CASE 
        WHEN AR.PAYMENT_TERM IN ('T014','TO14') THEN 'T014'
        WHEN AR.PAYMENT_TERM IN ('T030','TO30') THEN 'T030'
        WHEN AR.PAYMENT_TERM IN ('T045','TO45') THEN 'T045'
        ELSE AR.PAYMENT_TERM 
    END AS PAYMENT_TERM,
    AR.DISTRIBUTION_CHANNEL || ' - ' || AR.DISTRIBUTION_CHANNEL_DESC AS DISTRIBUTION_CHANNEL_FULL,
    AR.SALES_OFFICE || ' - ' || AR.SALES_OFFICE_DESC AS SALES_OFFICE_FULL,
    AR.PROFIT_CENTER || ' - ' || AR.PROFIT_CENTER_NAME AS PROFIT_CENTER_FULL,
    AR.BLOCK_FOR_SALES,
    AR.DELETION_FOR_SALES,
    COALESCE(
        NULLIF(AR.CREDIT_LIMIT, 0),
        MAX(NULLIF(AR.CREDIT_LIMIT, 0)) 
            OVER (PARTITION BY AR.CREDIT_OWNER)
    ) AS EFFECTIVE_CREDIT_LIMIT,
    SUM(AR.TOTAL_AMOUNT)
        OVER (PARTITION BY AR.CREDIT_OWNER) 
        AS TOTAL_AMOUNT_PER_CREDIT_OWNER,
    CASE 
        WHEN
            SUM(AR.TOTAL_AMOUNT)
                OVER (PARTITION BY AR.CREDIT_OWNER)
            >
            COALESCE(
                NULLIF(AR.CREDIT_LIMIT, 0),
                MAX(NULLIF(AR.CREDIT_LIMIT, 0)) 
                    OVER (PARTITION BY AR.CREDIT_OWNER)
            )
        THEN TRUE
        ELSE FALSE
    END AS IS_EXCEED_CL,
    CASE 
        WHEN AR.DUE_DATE < CURRENT_DATE THEN 'Overdue'
        ELSE 'Not Due'
    END AS DUE_STATUS,
    CASE 
        WHEN MAX(CASE WHEN AR.DUE_DATE < CURRENT_DATE THEN 1 ELSE 0 END)
             OVER (PARTITION BY AR.CUSTOMER) = 1
        THEN 'Overdue'
        ELSE 'Not Due'
    END AS CUSTOMER_DUE,
CASE
    WHEN AR.DUE_DATE >= CURRENT_DATE
        THEN 'Not Due'
    WHEN MAX(
        CASE
            WHEN AR.DUE_DATE < CURRENT_DATE
            THEN DATEDIFF('day', AR.DUE_DATE, CURRENT_DATE)
            ELSE 0
        END
    ) OVER (PARTITION BY AR.CUSTOMER) > 14
        THEN '>14 hari'
    ELSE
        MAX(
            CASE
                WHEN AR.DUE_DATE < CURRENT_DATE
                THEN DATEDIFF('day', AR.DUE_DATE, CURRENT_DATE)
                ELSE 0
            END
        ) OVER (PARTITION BY AR.CUSTOMER) || ' hari'
    END AS TOTAL_OVERDUE,
    AR.SOURCE_SYSTEM,
    AR.COMPANY_CODE,
    AR.CUSTOMER_CLASS || ' - ' || AR.CUSTOMER_CLASS_DESC AS CUSTOMER_CLASS,
    AR.FP_CORETAX,
    AR.SALES_EMPLOYEE || ' - ' || AR.SALES_EMPLOYEE_DESC AS SALES_EMPLOYEE_FULL,
CASE
    WHEN MAX(
        CASE
            WHEN AR.DUE_DATE < CURRENT_DATE
            THEN DATEDIFF('day', AR.DUE_DATE, CURRENT_DATE)
            ELSE 0
        END
    ) OVER (PARTITION BY AR.CREDIT_OWNER) = 0
        THEN 'COL 1'
    WHEN MAX(
        CASE
            WHEN AR.DUE_DATE < CURRENT_DATE
            THEN DATEDIFF('day', AR.DUE_DATE, CURRENT_DATE)
            ELSE 0
        END
    ) OVER (PARTITION BY AR.CREDIT_OWNER) BETWEEN 1 AND 15
        THEN 'COL 2'
    WHEN MAX(
        CASE
            WHEN AR.DUE_DATE < CURRENT_DATE
            THEN DATEDIFF('day', AR.DUE_DATE, CURRENT_DATE)
            ELSE 0
        END
    ) OVER (PARTITION BY AR.CREDIT_OWNER) BETWEEN 16 AND 60
        THEN 'COL 3'
    WHEN MAX(
        CASE
            WHEN AR.DUE_DATE < CURRENT_DATE
            THEN DATEDIFF('day', AR.DUE_DATE, CURRENT_DATE)
            ELSE 0
        END
    ) OVER (PARTITION BY AR.CREDIT_OWNER) BETWEEN 61 AND 120
        THEN 'COL 4'
    WHEN MAX(
        CASE
            WHEN AR.DUE_DATE < CURRENT_DATE
            THEN DATEDIFF('day', AR.DUE_DATE, CURRENT_DATE)
            ELSE 0
        END
    ) OVER (PARTITION BY AR.CREDIT_OWNER) > 120
        THEN 'COL 5'
END AS COL_STATUS
FROM PROD_DB.DSTR_BI_COMMUNITY.F_FINANCE_AR_AGING_CUSTOMER_MONTHLY_CURRENT AR
LEFT JOIN (
    SELECT SOURCE_SYSTEM, COMPANY_CODE, BILLING_NUMBER,
           MIN(BILLING_CREATED_DATE) AS BILLING_CREATED_DATE,
           MIN(TO_DATE(BILLING_DATE, 'YYYYMMDD')) AS BILLING_DATE
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_BILLING
    GROUP BY ALL
) BILL
    ON AR.SOURCE_SYSTEM = BILL.SOURCE_SYSTEM
    AND AR.COMPANY_CODE = BILL.COMPANY_CODE
    AND AR.BILLING_NUMBER = BILL.BILLING_NUMBER
LEFT JOIN (
    SELECT SOURCE_SYSTEM, COMPANY_CODE, BILLING_NUMBER, 
           MIN(TO_DATE(TTF_DOC_DATE, 'YYYYMMDD')) AS TTF_DOC_DATE
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_SALES_BILLING_TTF
    GROUP BY ALL
) TF
    ON AR.SOURCE_SYSTEM = TF.SOURCE_SYSTEM
   AND AR.COMPANY_CODE = TF.COMPANY_CODE
   AND AR.BILLING_NUMBER = TF.BILLING_NUMBER
LEFT JOIN (
    SELECT DISTINCT SOURCE_SYSTEM, COMPANY_CODE, ACCOUNTING_DOCUMENT_NUMBER, FISCAL_YEAR,
           TO_DATE(POSTING_DATE, 'YYYYMMDD') AS POSTING_DATE
    FROM PROD_DB.DSTR_BI_COMMUNITY.F_FINANCE_ACCOUNTING_DOCUMENT_HEADER
) AD
    ON AR.SOURCE_SYSTEM = AD.SOURCE_SYSTEM
   AND AR.COMPANY_CODE = AD.COMPANY_CODE
   AND AR.ACCOUNT_DOC_NUMBER = AD.ACCOUNTING_DOCUMENT_NUMBER
   AND AR.FISCAL_YEAR = AD.FISCAL_YEAR
WHERE AR.SOURCE_SYSTEM = 'PE1'
AND AR.PROFIT_CENTER LIKE '85%'
AND AR.GL_ACCOUNT IN ('1131110000', '1131141999', '1131211000', '1131221000', '1132111000')
;
